---
import '../styles/global.css';
import { APP_STORE_ID, APP_STORE_URL, PLAY_STORE_URL } from '../data/stores';
import { organizationJsonLd, softwareApplicationJsonLd, websiteJsonLd } from '../lib/seo';
import { site } from '../site.config';
import { preloadFonts } from '../styles/fonts';
import Analytics from '../components/Analytics.astro';
import {
  absoluteUrl,
  alternatesOf,
  defaultLocale,
  link,
  localeRelative,
  localeTag,
  multilingual,
  type Locale,
} from '@/i18n';
import { m } from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /**
   * URL of this page in each language it exists in. Defaults to the same path in every language that has it
   * (`notYet` in src/i18n). Ignored on a single-language site: no hreflang.
   */
  alternates?: Partial<Record<Locale, string>>;
}

const {
  title,
  description = m.meta_description_default(),
  image = site.ogImage,
  type = 'website',
  noindex = false,
  alternates: given,
} = Astro.props;

const locale = getLocale() as Locale;
// hreflang only where there is another language to point to, and never from a page kept out of the index.
const alternates = multilingual && !noindex ? (given ?? alternatesOf(localeRelative(Astro.url.pathname))) : {};
const alternateLinks = Object.entries(alternates) as Array<[Locale, string]>;
const hasTranslations = alternateLinks.length > 1;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// Site-wide structured data (src/lib/seo.ts); pages add their own (breadcrumb, FAQ).
const stores = [APP_STORE_URL, PLAY_STORE_URL];
const schemas = [
  organizationJsonLd(site, stores),
  websiteJsonLd(site, locale),
  softwareApplicationJsonLd(site, {
    description,
    installUrl: stores,
    offer: m.schema_offer_description(),
    language: locale,
  }),
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    {/* Fonts of the first screen, fetched at once: no visible swap, no layout shift. */}
    {preloadFonts.map((font) => (
      <link rel="preload" href={font} as="font" type="font/woff2" crossorigin />
    ))}
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    {hasTranslations &&
      alternateLinks.map(([lang, path]) => (
        <link rel="alternate" hreflang={lang} href={absoluteUrl(path)} />
      ))}
    {hasTranslations && alternates[defaultLocale] && (
      <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates[defaultLocale])} />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={localeTag(locale).replace('-', '_')} />
    {hasTranslations &&
      alternateLinks
        .filter(([lang]) => lang !== locale)
        .map(([lang]) => (
          <meta property="og:locale:alternate" content={localeTag(lang).replace('-', '_')} />
        ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Favicons (no web app manifest: the site is not installable, the app is in the stores) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- iOS Smart App Banner (Safari shows a native "Open in App Store" banner) -->
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />

    <!-- Theme Color -->
    <meta name="theme-color" content={site.themeColor} />

    <!-- JSON-LD Structured Data -->
    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    <Analytics />
  </head>
  <body class="min-h-screen bg-concrete text-ink" data-privacy-href={link(locale, 'privacy')}>
    <slot />
  </body>
</html>
