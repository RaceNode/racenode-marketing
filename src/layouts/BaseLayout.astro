---
import '../styles/global.css';
import { APP_STORE_ID, APP_STORE_URL, PLAY_STORE_URL } from '../data/stores';
import { organizationJsonLd, softwareApplicationJsonLd, websiteJsonLd } from '../lib/seo';
import { site } from '../site.config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = "Racing team management software: travel, hotels, roles and the race weekend timetable, on every crew member's phone.",
  image = site.ogImage,
  type = "website",
  noindex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

// Site-wide structured data (src/lib/seo.ts); pages add their own (breadcrumb, FAQ).
const stores = [APP_STORE_URL, PLAY_STORE_URL];
const schemas = [
  organizationJsonLd(site, stores),
  websiteJsonLd(site, 'en'),
  softwareApplicationJsonLd(site, { description, installUrl: stores }),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Favicons & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- iOS Smart App Banner (Safari shows a native "Open in App Store" banner) -->
    <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />

    <!-- Theme Color -->
    <meta name="theme-color" content={site.themeColor} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- JSON-LD Structured Data -->
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body class="min-h-screen bg-concrete text-ink">
    <slot />
    <script>
      import '../lib/analytics.mjs';
    </script>
  </body>
</html>
