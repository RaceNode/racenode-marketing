---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
}

const { title, description, heading } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="min-h-screen bg-concrete flex flex-col">
    <Header />
    <main class="flex-1">
      <div class="page max-w-4xl py-12 md:py-16">
        <!-- Header with back link -->
        <div class="mb-10">
          <a href="/" class="link mb-8 inline-block">
            Back to Home
          </a>
          <h1 class="title">{heading}</h1>
        </div>

        <!-- Document content: printed paper, ink text -->
        <div class="ruled bg-paper px-5 pb-10 sm:px-10">
          <div class="prose prose-sm max-w-none pt-4
            prose-headings:font-display prose-headings:font-semibold prose-headings:text-ink
            prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-3
            prose-h3:text-xl prose-h3:mt-5 prose-h3:mb-2
            prose-p:text-graphite prose-p:leading-relaxed
            prose-ul:text-graphite prose-ol:text-graphite
            prose-li:text-graphite
            prose-strong:text-ink prose-strong:font-semibold
            prose-a:text-accent hover:prose-a:text-accent-hover prose-a:underline
            prose-hr:border-line prose-hr:my-6">
            <slot />
          </div>
        </div>

        <!-- Footer -->
        <div class="mt-10">
          <a href="/" class="link">
            Return to RaceNode
          </a>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
