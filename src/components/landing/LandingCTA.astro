---
import { m } from '@/paraglide/messages';
import { appUrl } from '@/lib/app';
import type { Locale } from '@/i18n';
import { getLocale } from '@/paraglide/runtime';
import Icon from '../Icon.astro';

const locale = getLocale() as Locale;

// What holds once a team pays (src/pages/pricing.astro); the price itself stays on that page.
const assurances = [m.home_assure_modules(), m.home_assure_crew(), m.home_assure_eu()];
---

<!-- The end of the dark block that opens with the crew's app (LandingSync): a hairline, who built it, then the call.
     The paddock line was a light band of its own between two dark ones; it now leads into the call. -->
<section class="band-dark pb-20 md:pb-28">
  <div class="page">
    <div class="hair grid gap-8 pt-12 md:pt-16 lg:grid-cols-12 lg:items-end lg:gap-10">
      <div class="lg:col-span-8">
        <p class="font-display text-lg font-medium text-fog">{m.home_cta_built()}</p>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-smoke md:text-base">
          {m.home_cta_bio()}
        </p>
        <h2 class="title mt-8 md:mt-10">{m.home_cta_title()}</h2>
        <p class="lede mt-5 max-w-2xl">{m.common_free_until_cta()}</p>
        <ul class="mt-6 grid gap-2 sm:grid-cols-3 sm:gap-6">
          {assurances.map((line) => (
            <li class="flex items-center gap-2.5 font-medium text-fog">
              <Icon name="check" class="size-4 shrink-0 text-smoke" />
              {line}
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-4 lg:text-right">
        <a href={appUrl(locale, '/signup')} class="btn-primary text-lg">
          {m.common_start_free()}
        </a>
      </div>
    </div>
  </div>
</section>
