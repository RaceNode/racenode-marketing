---
const appUrl = "https://app.racenode.com";
---

<section class="px-4 sm:px-6 lg:px-8 py-20 md:py-24 bg-gray-900/50">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
      Use RaceNode for free this season.
    </h2>
    <p class="text-lg text-gray-400 mb-8 max-w-2xl mx-auto">
      We're building RaceNode alongside our own GT3 program. For 2026, the platform is free for all teams. Your feedback shapes the product.
    </p>

    <!-- CTA Button -->
    <a
      href={`${appUrl}/signup`}
      class="inline-block bg-accent hover:bg-accent-hover text-white px-8 py-3 rounded-lg text-lg font-semibold transition-colors"
    >
      Create your account
    </a>
  </div>
</section>
