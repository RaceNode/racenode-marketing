---
import { m } from '@/paraglide/messages';
import CrewScreen from '../CrewScreen.astro';

// The lower half of the screen in the hero: the same race weekend, scrolled.
const items = [
  { label: m.common_my_accommodation(), text: m.home_sync_acc_text() },
  {
    label: m.common_departure_return(),
    text: m.common_departure_return_text(),
  },
  { label: m.common_daily_transfer(), text: m.home_sync_daily_text() },
  {
    label: m.home_sync_above(),
    text: m.home_sync_above_text(),
  },
];
---

<div class="kerb" aria-hidden="true"></div>
<!-- Opens the closing dark block: the kerb is the one light-to-dark edge on the way down; the call (LandingCTA)
     follows on the same asphalt. -->
<section class="band-dark py-14 md:py-24">
  <div class="page">
    <div class="head">
      <h2 class="title">{m.home_sync_title()}</h2>
      <p class="lede">{m.home_sync_lede()}</p>
    </div>

    <CrewScreen screen="more" items={items} />
  </div>
</section>
