---
import StoreBadges from "../StoreBadges.astro";

const examples = [
  { label: 'Role', value: 'Race Engineer on #42' },
  { label: 'Flight', value: 'LHR to MXP, Sep 12' },
  { label: 'Hotel', value: 'Grand Hotel, Room 204' },
  { label: 'Meals', value: 'Paddock, 12:00-13:00' },
];
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Assign once, everyone knows.
      </h2>
      <p class="lede">
        When you assign a role, a car, a flight, or a meal, your team member sees it instantly in their Personal app. No briefing email, no message forwarding, no information lost in transit.
      </p>
    </div>

    <!-- Two ends of one line: what the manager sets is what the crew sees. -->
    <div class="grid items-center gap-6 md:grid-cols-[1fr_auto_1fr] md:gap-8">
      <div class="ruled">
        <h3 class="subtitle">Team Manager</h3>
        <p class="mt-2 text-smoke">Assigns roles, logistics, and meals in RaceNode</p>
      </div>

      <div class="flex items-center gap-3 md:min-w-56 md:flex-col md:gap-2">
        <span class="h-8 w-px bg-accent-soft md:h-px md:w-full" aria-hidden="true"></span>
        <span class="font-display text-base font-medium whitespace-nowrap text-accent-soft">Instant sync</span>
      </div>

      <div class="ruled">
        <h3 class="subtitle">Staff Member</h3>
        <p class="mt-2 text-smoke">Sees their assignments in the RaceNode app, on iPhone or Android</p>
      </div>
    </div>

    <!-- What lands on the phone, set like a line of a timing screen. -->
    <dl class="mt-14 grid border-y border-asphalt-line sm:grid-cols-2 lg:grid-cols-4">
      {examples.map(({ label, value }, i) => (
        <div class:list={["flex flex-col gap-1 py-5 sm:px-5", i > 0 && "border-t border-asphalt-line sm:border-t-0", i % 2 === 1 && "sm:border-l", i >= 2 && "sm:border-t lg:border-t-0", i > 0 && "lg:border-l"]}>
          <dt class="font-display text-sm text-smoke">{label}</dt>
          <dd class="font-mono text-[0.95rem] text-white">{value}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-12 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-md font-medium text-smoke">
        The Personal module is included free with any subscription. Get the app:
      </p>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
