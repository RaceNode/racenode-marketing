---
import StoreBadges from "../StoreBadges.astro";
import CrewScreen from "../CrewScreen.astro";

// The lower half of the screen in the hero: the same race weekend, scrolled.
const items = [
  { label: 'My accommodation', text: 'The hotel and who shares the room, from Logistics.' },
  { label: 'Departure and return', text: 'The route, the vehicle or the flight, and who travels with them.' },
  { label: 'Daily transfer', text: 'The vehicle that takes them to the circuit.' },
  { label: 'Above it', text: 'Up next from the Timetable, their role and their next meal from Management.' },
];
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Assign once, everyone knows.
      </h2>
      <p class="lede">
        When you assign a role, a car, a flight, or a meal, your team member sees it instantly in their Personal app. No briefing email, no message forwarding, no information lost in transit.
      </p>
    </div>

    <CrewScreen screen="more" items={items} />

    <div class="mt-14 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-md font-medium text-smoke">
        The Personal module is included free with any subscription. Get the app:
      </p>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
