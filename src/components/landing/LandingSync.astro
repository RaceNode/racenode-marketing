---
import StoreBadges from "../StoreBadges.astro";
import SyncLine from "../SyncLine.astro";
import Icon from "../Icon.astro";
import type { IconName } from "../icons";

const examples: { label: string; value: string; icon: IconName }[] = [
  { label: 'Role', value: 'Race Engineer on #42', icon: 'user' },
  { label: 'Flight', value: 'LHR to MXP, Sep 12', icon: 'plane' },
  { label: 'Hotel', value: 'Grand Hotel, Room 204', icon: 'bed' },
  { label: 'Meals', value: 'Paddock, 12:00-13:00', icon: 'utensils' },
];
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Assign once, everyone knows.
      </h2>
      <p class="lede">
        When you assign a role, a car, a flight, or a meal, your team member sees it instantly in their Personal app. No briefing email, no message forwarding, no information lost in transit.
      </p>
    </div>

    <SyncLine
      from={{ role: "Team Manager", text: "Assigns roles, logistics, and meals in RaceNode" }}
      to={{ role: "Staff Member", text: "Sees their assignments in the RaceNode app, on iPhone or Android" }}
    />

    <!-- What lands on the phone, as the tiles of the app's event screen. -->
    <dl class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {examples.map(({ label, value, icon }) => (
        <div class="app-card flex items-center gap-3.5 p-4">
          <span class="app-icon"><Icon name={icon} /></span>
          <div class="flex min-w-0 flex-col gap-1">
            <dt class="app-label">{label}</dt>
            <dd class="font-mono text-[0.95rem] text-white">{value}</dd>
          </div>
        </div>
      ))}
    </dl>

    <div class="mt-12 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-md font-medium text-smoke">
        The Personal module is included free with any subscription. Get the app:
      </p>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
