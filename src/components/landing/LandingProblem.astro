---
import Icon from '../Icon.astro';
import type { IconName } from '../icons';

// Four short lines, after the proof: the pains are named, not illustrated (the cards made a screen and a half on a phone).
const painPoints: { text: string; icon: IconName }[] = [
  { text: 'A clean pre-event PDF, and each person reads one line of it.', icon: 'file-text' },
  { text: 'Details lost in WhatsApp threads and email chains.', icon: 'message' },
  { text: "A brief you can't send while half of it is missing.", icon: 'file-x' },
  { text: 'A change after the "final" V3. Again.', icon: 'refresh' },
];
---

<section class="band-paper py-14 md:py-20">
  <div class="page grid gap-8 lg:grid-cols-12 lg:gap-10">
    <h2 class="subtitle lg:col-span-5">Running a race team means juggling everything at once.</h2>
    <ul class="grid gap-x-10 gap-y-4 md:grid-cols-2 lg:col-span-7">
      {painPoints.map((point) => (
        <li class="flex items-start gap-3">
          <span class="pain-mark size-8 [&_svg]:size-4">
            <Icon name={point.icon} />
          </span>
          <span class="pt-0.5 text-lg leading-snug font-medium">{point.text}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
