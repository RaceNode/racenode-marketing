---
import { m } from '@/paraglide/messages';
import Shot from '../Shot.astro';
import importScreen from '../../assets/screenshots/logistics-import.png';
import importPhone from '../../assets/screenshots/logistics-import-phone.png';
---

<!-- The product's proof, right under the hero: a document in, the bookings out, checked before saving.
     The formats are the ones the app reads (racenode: src/lib/documentImport/read/readDocument.ts). -->
<section id="how-it-works" class="pt-14 pb-14 md:pt-24 md:pb-20">
  <div class="page grid items-start gap-8 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4">
      <h2 class="title">{m.home_import_title()}</h2>
      <p class="muted mt-5 text-lg leading-relaxed">{m.home_import_text()}</p>
      <p class="muted mt-4 text-sm leading-relaxed">{m.home_import_formats()}</p>
    </div>
    <div class="lg:col-span-8">
      <Shot
        desktop={importScreen}
        phone={importPhone}
        phoneClass="max-w-[14rem]"
        alt={m.common_import_alt()}
      />
    </div>
  </div>
</section>
