---
import { Image } from 'astro:assets';
import screenshotModules from '../../assets/screenshots/landing-modules.png';
---

<!-- The product: the season home, cropped to the part with data. Every module column stays in
     the frame on wide screens; on a phone, zoomed on the first two so they can be read. -->
<section class="band band-paper">
  <div class="page">
    <div class="head">
      <h2 class="title">
        One racing team management platform, organized around your events.
      </h2>
      <p class="lede">
        RaceNode is built around the way motorsport teams actually work: event by event. Each race weekend has its own workspace with its staff, racecars, logistics, and meals. You prepare one event at a time — your race team management software should work the same way.
      </p>
    </div>

    <div class="screen -mx-4 sm:mx-0">
      <div class="screen-crop screen-zoom sm:aspect-[15/4] sm:[&_img]:w-full" style="--zoom-aspect: 5 / 4">
        <Image
          src={screenshotModules}
          alt="RaceNode - Choose your module: Personal, Staff, Fleet, Racecars, Events, Management, Logistics"
          widths={[900, 1400, 2000, 2800]}
          sizes="(min-width: 1248px) 1200px, (min-width: 640px) 100vw, 350vw"
          quality={85}
        />
      </div>
    </div>
  </div>
</section>
