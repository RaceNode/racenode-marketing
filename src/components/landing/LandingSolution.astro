---
import Shot from '../Shot.astro';
import screenshotModulesPhone from '../../assets/screenshots/landing-modules-phone.png';
import screenshotModules from '../../assets/screenshots/landing-modules.png';
---

<!-- The product: the season home, cropped to the part with data. Every module column stays in
     the frame on wide screens; on a phone, the app's own phone home. -->
<section class="band band-paper">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Organized around your race weekends.
      </h2>
      <p class="lede">
        RaceNode is racing team management software built the way teams work: each event has its own crew, cars, travel and meals. You prepare one weekend at a time; so does RaceNode.
      </p>
    </div>

    <Shot
      desktop={screenshotModules}
      phone={screenshotModulesPhone}
      alt="RaceNode season home: each upcoming race weekend with its Management, Timetable and Logistics progress"
      crop
      screenClass="-mx-4 sm:mx-0"
      cropClass="sm:aspect-[15/4] sm:[&_img]:w-full"
      sizes="(min-width: 1248px) 1200px, 100vw"
    />
  </div>
</section>
