---
import { m } from '@/paraglide/messages';
import { appUrl } from '@/lib/app';
import type { Locale } from '@/i18n';
import { getLocale } from '@/paraglide/runtime';
import { Image } from 'astro:assets';
import StoreBadges from '../StoreBadges.astro';
import LandingSeasonProof from './LandingSeasonProof.astro';
import raceWeekend from '../../assets/screenshots/crew-app-race-weekend.png';

const locale = getLocale() as Locale;
---

<!-- Opening: the promise on the left, the crew's phone rising from the track edge on the right, then the 2026
     season under that edge, in the same dark band: one opening, read in one go. -->
<section class="band-dark overflow-hidden">
  <div class="page">
    <!-- On a 390 px phone, the free line stays above the cookie banner: buttons side by side, tight top. -->
    <div class="grid border-b border-asphalt-line gap-12 overflow-hidden pt-8 md:pt-20 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7 lg:pb-24">
        <p class="font-display text-lg font-medium text-smoke">{m.home_hero_built()}</p>

        <h1 class="display mt-3 md:mt-5">{m.home_hero_title()}</h1>

        <p class="lede mt-5 max-w-2xl md:mt-8">{m.home_hero_lede()}</p>

        <div class="mt-6 flex flex-wrap items-center gap-3 md:mt-10">
          <a href={appUrl(locale, '/signup')} class="btn-primary sm:text-lg">
            {m.common_start_free()}
          </a>
          <a href="#how-it-works" class="btn-ghost sm:text-lg">
            {m.home_hero_how()}
          </a>
        </div>
        <p class="mt-4 max-w-md text-sm text-smoke">{m.common_free_until_cta()}</p>

        <div class="hair mt-12 flex flex-col gap-4 pt-6 sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-xs text-sm text-smoke">{m.home_hero_app()}</p>
          <StoreBadges align="start" />
        </div>
      </div>

      <!-- The phone sits on the track edge (the rule under it) and is cut by it. -->
      <div class="flex h-[22rem] items-start justify-center sm:h-[30rem] lg:col-span-5 lg:h-auto lg:items-end lg:justify-end">
        <div class="phone w-[17rem] translate-y-0 sm:w-[19rem] lg:-mb-40 lg:w-[21rem]">
          <Image
            src={raceWeekend}
            alt=""
            widths={[340, 680]}
            sizes="(min-width: 1024px) 21rem, 17rem"
            loading="eager"
            quality={85}
          />
        </div>
      </div>
    </div>
    <LandingSeasonProof />
  </div>
</section>
<div class="kerb" aria-hidden="true"></div>
