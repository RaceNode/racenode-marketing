---
import { Image } from "astro:assets";
import StoreBadges from "../StoreBadges.astro";
import raceWeekend from "../../assets/screenshots/crew-app-race-weekend.png";

const appUrl = "https://app.racenode.com";
---

<!-- Opening: the promise on the left, the crew's phone rising from the track edge on the right. -->
<section class="band-dark overflow-hidden">
  <div class="page grid gap-12 pt-14 md:pt-20 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7 lg:pb-24">
      <p class="font-display text-lg font-medium text-smoke">
        Built by a racing Team Manager
      </p>

      <h1 class="display mt-5">
        Racing team management software,
        <span class="block">finally in one place.</span>
      </h1>

      <p class="lede mt-8 max-w-2xl">
        RaceNode is racing team management software. Staff, fleet, racecars, logistics, and events — all structured around your race weekends, in one race team operations platform.
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={`${appUrl}/signup`} class="btn-primary text-lg">Get started</a>
        <a href="#how-it-works" class="btn-ghost text-lg">See how it works</a>
      </div>
      <p class="mt-4 text-sm text-smoke">Free for the 2026 season.</p>

      <div class="hair mt-12 flex flex-col gap-4 pt-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-xs text-sm text-smoke">Your crew gets the RaceNode app on iPhone and Android.</p>
        <StoreBadges align="start" />
      </div>
    </div>

    <!-- The phone sits on the bottom edge of the band and is cut by it. -->
    <div class="flex h-[26rem] items-start justify-center sm:h-[30rem] lg:col-span-5 lg:h-auto lg:items-end lg:justify-end">
      <div class="phone w-[17rem] translate-y-0 sm:w-[19rem] lg:-mb-40 lg:w-[21rem]">
        <Image
          src={raceWeekend}
          alt=""
          widths={[340, 680]}
          sizes="(min-width: 1024px) 21rem, 17rem"
          loading="eager"
          quality={85}
        />
      </div>
    </div>
  </div>
</section>
<div class="kerb" aria-hidden="true"></div>
