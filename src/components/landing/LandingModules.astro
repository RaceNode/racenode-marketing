---
import { CREW_DAYS_IN_PLANNING } from '../../data/crew-days';

const modules = [
  {
    name: 'Management',
    tagline: 'Event management, structured.',
    features: [
      'Roles per car and per crew, for every event',
      'Racecar entries per event',
      'Meals: where, when, who eats there'
    ],
    href: '/management/'
  },
  {
    name: 'Logistics',
    tagline: 'Event logistics, centralized.',
    features: [
      'Flights, trains, team vehicles and hotels, room by room',
      'Flags anyone missing a flight, a hotel or a ride',
      'Bookings filled in from the confirmation you drop'
    ],
    href: '/logistics/'
  },
  {
    name: 'Timetable',
    tagline: 'Event schedule, in real time.',
    features: [
      'Team schedule alongside the official sessions',
      'Briefings set once, anchored to the sessions',
      'Live countdown on the screen in your box'
    ],
    href: '/timetable/'
  },
  {
    name: 'Planning',
    tagline: 'The whole season, one grid.',
    features: [
      'Staff, racecars and trucks on one season grid',
      'Five day codes, painted by drag',
      CREW_DAYS_IN_PLANNING ? 'Availability posted by your own crew' : 'Partial attendance per person and per truck'
    ],
    href: '/crew-planning/'
  }
];
---

<!-- A ledger, not a card grid: one row per module. -->
<section class="band">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Modules that work together.
      </h2>
      <p class="lede">
        Staff, fleet, racecars and events are shared by every module: entered once, used everywhere.
      </p>
    </div>

    <ul>
      {modules.map((module) => (
        <li class="ruled grid gap-6 pb-12 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-4">
            <h3 class="font-display text-5xl font-bold tracking-[-0.02em] md:text-6xl">{module.name}</h3>
            <p class="muted mt-2 text-lg">{module.tagline}</p>
          </div>

          <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-3 lg:col-span-6 lg:pt-3">
            {module.features.map((feature) => (
              <li class="hair pt-3 leading-snug">{feature}</li>
            ))}
          </ul>

          <div class="lg:col-span-2 lg:pt-3 lg:text-right">
            <a href={module.href} class="link">Learn more</a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
