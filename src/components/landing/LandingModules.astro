---
import { Image } from 'astro:assets';
import { modules } from '../../data/modules';
---

<!-- One card per module, the whole card a link to its page: the app's phone screen, whole (never cut by the
     tile), in an asphalt tile, the name, two or three concrete lines. Three cards then two on wide screens. -->
<section class="band">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Modules that work together.
      </h2>
      <p class="lede">
        Staff, fleet, racecars and events are shared by every module: entered once, used everywhere.
      </p>
    </div>

    <ul class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-6 lg:gap-x-8">
      {modules.map((module, i) => (
        <li class:list={[i < 3 ? 'lg:col-span-2' : 'lg:col-span-3', i === modules.length - 1 && 'sm:col-span-2 lg:col-span-3']}>
          <a href={module.href} class="group flex h-full flex-col">
            <div class="flex justify-center rounded-[4px] bg-asphalt px-6 py-8">
              <div class="phone w-40 shrink-0 border-[5px] transition-transform duration-300 motion-safe:group-hover:-translate-y-1">
                <Image src={module.phone} alt={module.phoneAlt} widths={[400, 600]} sizes="10rem" quality={80} />
              </div>
            </div>
            <h3 class="ruled mt-6 font-display text-3xl font-bold tracking-[-0.01em] md:text-4xl">{module.name}</h3>
            <p class="muted mt-3 max-w-xl leading-relaxed">{module.summary}</p>
            <span class="link mt-4 self-start decoration-transparent group-hover:decoration-current">
              See {module.name} <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
