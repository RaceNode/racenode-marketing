---
const freeModules = ['Personal', 'Staff', 'Events', 'Fleet', 'Racecars'];

const paidModules = [
  {
    name: 'Management',
    tagline: 'Event management, structured.',
    features: [
      'Staff assignments with role definitions',
      'Racecar entries per event',
      'Team structure and crew composition',
      'Meal planning and allocation'
    ],
    href: '/management/'
  },
  {
    name: 'Logistics',
    tagline: 'Event logistics, centralized.',
    features: [
      'Multi-segment travel arrangements',
      'Accommodation with room management',
      'Smart alerts for missing bookings',
      'Document attachments for tickets and confirmations'
    ],
    href: '/logistics/'
  },
  {
    name: 'Timetable',
    tagline: 'Event schedule, in real time.',
    features: [
      'Team schedule alongside official sessions',
      'Reusable item templates and autocomplete',
      'Automation rules anchored to sessions',
      'Public iCal feed and live countdown display'
    ],
    href: '/timetable/'
  },
  {
    name: 'Planning',
    tagline: 'The whole season, one grid.',
    features: [
      'Staff, racecars, and trucks on one season grid',
      'Five day codes, painted by drag',
      'Partial attendance per person and per truck',
      'Availability posted by your own crew'
    ],
    href: '/crew-planning/'
  }
];
---

<!-- A ledger, not a card grid: the base everyone gets on one line, then one row per module. -->
<section class="band">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Modules that work together.
      </h2>
      <p class="lede">
        Start with the basics, add what you need. All modules share the same data.
      </p>
    </div>

    <div class="ruled grid gap-4 pb-10 lg:grid-cols-12 lg:gap-10">
      <h3 class="font-display text-lg font-medium text-graphite lg:col-span-4">Base modules</h3>
      <ul class="flex flex-wrap gap-x-4 gap-y-1 lg:col-span-8">
        {freeModules.map((name) => (
          <li class="font-display text-2xl font-semibold md:text-4xl [&:not(:last-child)]:after:ml-4 [&:not(:last-child)]:after:text-line [&:not(:last-child)]:after:content-['/']">
            {name}
          </li>
        ))}
      </ul>
    </div>

    <ul>
      {paidModules.map((module) => (
        <li class="ruled grid gap-6 pb-12 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-4">
            <h3 class="font-display text-5xl font-bold tracking-[-0.02em] md:text-6xl">{module.name}</h3>
            <p class="muted mt-2 text-lg">{module.tagline}</p>
          </div>

          <ul class="grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:col-span-6 lg:pt-3">
            {module.features.map((feature) => (
              <li class="hair pt-3 leading-snug">{feature}</li>
            ))}
          </ul>

          <div class="lg:col-span-2 lg:pt-3 lg:text-right">
            <a href={module.href} class="link">Learn more</a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
