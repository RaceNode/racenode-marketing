---
import { seasonProof, seasonProofLabel } from '../../data/season-proof';
---

<!-- Three across even on a phone: the logo above its name, in gray but dark enough to read. -->
<section class="band-paper py-10 md:py-14" aria-label={seasonProofLabel}>
  <div class="page">
    <p class="muted max-w-3xl">{seasonProofLabel}</p>
    <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-4 sm:gap-8">
      {seasonProof.map((item) => (
        <li class="flex flex-col items-start gap-2">
          <img
            src={item.logo}
            alt=""
            width="96"
            height="48"
            loading="lazy"
            class="h-12 w-24 shrink-0 object-contain object-left opacity-90 grayscale"
          />
          <span class="text-xs font-medium leading-snug sm:text-sm">{item.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
