---
import Icon from "../Icon.astro";
import type { IconName } from "../icons";

const upcomingModules: { name: string; description: string; icon: IconName }[] = [
  {
    name: 'Finance',
    description: 'Championship costing and cash-flow planning — know what the season costs before it starts, and where the money goes as it runs.',
    icon: 'wallet',
  },
  {
    name: 'AI',
    description: 'Smart insights and predictions to help you prepare faster and catch issues before they happen.',
    icon: 'sparkles',
  }
];
---

<section class="band">
  <div class="page">
    <div class="head">
      <h2 class="title">
        We're building more.
      </h2>
      <p class="lede">
        RaceNode is designed to grow into a full operational platform, one module at a time.
      </p>
    </div>

    <ul class="grid gap-x-12 gap-y-10 md:grid-cols-2">
      {upcomingModules.map((module) => (
        <li class="soon">
          <div class="flex items-center justify-between gap-4">
            <span class="flex size-12 items-center justify-center rounded-[3px] border-2 border-dashed border-graphite/50 text-graphite">
              <Icon name={module.icon} class="size-6" />
            </span>
            <span class="tag text-graphite">Coming soon</span>
          </div>
          <h3 class="title mt-6">{module.name}</h3>
          <p class="muted mt-4 max-w-xl text-lg leading-relaxed">{module.description}</p>
        </li>
      ))}
    </ul>

    <p class="muted mt-12 max-w-2xl text-sm">
      These are just the next steps. JobList, Tyres, Mechanics, Setup, Run, Data... we have a roadmap that covers the full racing operation. Built by racers, for racers.
    </p>
  </div>
</section>
