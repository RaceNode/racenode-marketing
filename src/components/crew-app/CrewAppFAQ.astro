---
import { crewAppFaq } from './faq';
---

<section class="band band-paper">
  <div class="page grid gap-10 lg:grid-cols-12 lg:gap-10">
    <h2 class="title lg:col-span-4">
      Questions team managers ask
    </h2>
    <div class="border-b border-line lg:col-span-8">
      {crewAppFaq.map((item) => (
        <details class="group border-t border-line py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-xl font-semibold [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="relative size-4 shrink-0 before:absolute before:top-1/2 before:left-0 before:h-0.5 before:w-4 before:-translate-y-1/2 before:bg-ink after:absolute after:top-0 after:left-1/2 after:h-4 after:w-0.5 after:-translate-x-1/2 after:bg-ink after:transition-transform group-open:after:scale-y-0" aria-hidden="true"></span>
          </summary>
          <p class="muted mt-3 max-w-2xl text-lg leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
