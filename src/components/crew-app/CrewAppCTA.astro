---
import StoreBadges from '../StoreBadges.astro';

const appUrl = "https://app.racenode.com";
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-10">
    <div class="lg:col-span-8">
      <h2 class="title">
        Plan your next event once. Let your crew read it.
      </h2>
      <p class="lede mt-5 max-w-2xl">
        Add one event, invite one crew member, and see what they see in a few minutes. No demo to book, no card.
      </p>
    </div>
    <div class="lg:col-span-4 lg:text-right">
      <a href={`${appUrl}/signup`} class="btn-primary text-lg">
        Start free
      </a>
    </div>
    <div class="hair flex flex-col gap-4 pt-6 sm:flex-row sm:items-center sm:justify-between lg:col-span-12">
      <p class="text-sm text-smoke">Free until 31 December 2026. Your crew downloads the app:</p>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
