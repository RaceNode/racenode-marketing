---
import StoreBadges from '../StoreBadges.astro';

const appUrl = "https://app.racenode.com";
---

<section class="px-4 sm:px-6 lg:px-8 py-20 md:py-24">
  <div class="max-w-4xl mx-auto">
    <div class="bg-gray-900 border border-gray-800 rounded-lg p-8 md:p-12 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">
        Plan your next event once. Let your crew read it.
      </h2>
      <p class="text-gray-400 mb-8 max-w-xl mx-auto">
        Add one event, invite one crew member, and see what they see in a few minutes. No demo to book.
      </p>
      <a
        href={`${appUrl}/signup`}
        class="inline-block bg-accent hover:bg-accent-hover text-white px-8 py-3 rounded-lg text-lg font-medium transition-colors mb-8"
      >
        Get started
      </a>
      <p class="text-gray-500 text-sm mb-4">Free for the 2026 season. Your crew downloads the app:</p>
      <StoreBadges />
    </div>
  </div>
</section>
