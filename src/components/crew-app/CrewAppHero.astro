---
import { Image } from 'astro:assets';
import StoreBadges from '../StoreBadges.astro';
import screenshotWeekend from '../../assets/screenshots/crew-app-race-weekend.png';

const appUrl = "https://app.racenode.com";

// The situation, never the tools: what a team manager answers all weekend long.
const questions = ["What time is my flight?", "Which hotel?", "Where's lunch?", "What's first tomorrow?"];
---

<!-- Opening: the questions of a race weekend on the left, the phone that answers them rising from the track edge. -->
<section class="band-dark overflow-hidden">
  <div class="page grid gap-12 pt-14 md:pt-20 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7 lg:pb-24">
      <p class="font-display text-lg font-medium text-smoke">
        Free for every team member
      </p>

      <h1 class="display mt-5">
        The race weekend app for your crew.
      </h1>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2" aria-label="Questions your crew asks every race weekend">
        {questions.map((q) => (
          <li class="font-display text-xl font-medium text-white md:text-2xl">“{q}”</li>
        ))}
      </ul>
      <p class="lede mt-8 max-w-2xl">
        Every race weekend, the same questions. Now each crew member finds their role, flight, hotel, meals and next session on their own phone, taken from what you already entered in RaceNode.
      </p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
        <a href={`${appUrl}/signup`} class="btn-primary text-lg">
          Get started
        </a>
        <span class="text-sm text-smoke">Free for the 2026 season</span>
      </div>
      <div class="hair mt-12 pt-6">
        <StoreBadges align="start" />
      </div>
    </div>

    <!-- The phone sits on the bottom edge of the band and is cut by it. -->
    <div class="flex h-[26rem] items-start justify-center sm:h-[30rem] lg:col-span-5 lg:h-auto lg:items-end lg:justify-end">
      <div class="phone w-[17rem] sm:w-[19rem] lg:-mb-40 lg:w-[21rem]">
        <Image
          src={screenshotWeekend}
          alt="RaceNode crew app on a phone: a chief mechanic's weekend at the Nürburgring with what is up next, his roles, his next meal and his hotel"
          widths={[340, 680]}
          sizes="(min-width: 1024px) 21rem, 17rem"
          loading="eager"
          quality={85}
        />
      </div>
    </div>
  </div>
</section>
<div class="kerb" aria-hidden="true"></div>
