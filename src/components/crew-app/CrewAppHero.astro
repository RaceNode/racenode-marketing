---
import { Image } from 'astro:assets';
import StoreBadges from '../StoreBadges.astro';
import screenshotWeekend from '../../assets/screenshots/crew-app-race-weekend.png';

const appUrl = "https://app.racenode.com";

// The situation, never the tools: what a team manager answers all weekend long.
const questions = ["What time is my flight?", "Which hotel?", "Where's lunch?", "What's first tomorrow?"];
---

<section class="px-4 sm:px-6 lg:px-8 py-16 md:py-24">
  <div class="max-w-6xl mx-auto flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
    <div class="lg:w-3/5 text-center lg:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-800 text-gray-300 rounded-full text-sm mb-6 border border-gray-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>
        </svg>
        Free for every team member
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
        The race weekend app for your crew.
      </h1>
      <ul class="flex flex-wrap justify-center lg:justify-start gap-2 mb-6" aria-label="Questions your crew asks every race weekend">
        {questions.map((q) => (
          <li class="px-3 py-1 bg-gray-900 border border-gray-800 rounded-full text-sm text-gray-300">“{q}”</li>
        ))}
      </ul>
      <p class="text-xl md:text-2xl text-gray-400 mb-8">
        Every race weekend, the same questions. Now each crew member finds their role, flight, hotel, meals and next session on their own phone, taken from what you already entered in RaceNode.
      </p>
      <div class="flex flex-col sm:flex-row items-center lg:justify-start justify-center gap-4 mb-8">
        <a
          href={`${appUrl}/signup`}
          class="bg-accent hover:bg-accent-hover text-white px-8 py-3 rounded-lg text-lg font-medium transition-colors"
        >
          Get started
        </a>
        <span class="text-gray-500 text-sm">Free for the 2026 season</span>
      </div>
      <div class="flex justify-center lg:justify-start">
        <StoreBadges align="start" />
      </div>
    </div>

    <div class="lg:w-2/5 w-full max-w-[300px]">
      <div class="rounded-2xl overflow-hidden shadow-2xl border border-gray-700">
        <Image
          src={screenshotWeekend}
          alt="RaceNode crew app on a phone: a race engineer's weekend at Spa with the next session, role, next meal and hotel"
          class="w-full h-auto"
          quality={85}
        />
      </div>
    </div>
  </div>
</section>
