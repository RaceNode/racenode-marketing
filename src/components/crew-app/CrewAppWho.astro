---
const groups = [
  {
    title: "Your crew",
    text: "Mechanics, engineers, truckies, hospitality. Invite them from Staff by email or with your team code; they sign in on the app or in a browser.",
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  },
  {
    title: "Your drivers",
    text: "Add them to Staff with the Driver role. They get the same weekend on their phone: schedule, hotel, travel, meals. No separate tool, no separate list.",
    icon: `<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>`,
  },
  {
    title: "Freelancers",
    text: "Someone who works for two teams keeps one account: both teams' events land in the same season, each marked with its team. Without a team yet, they can start on their own and join when invited.",
    icon: `<rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>`,
  },
];
---

<section class="px-4 sm:px-6 lg:px-8 py-16 md:py-24">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Everyone who travels with the team.
      </h2>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        The crew app is free for every member of your team. Nobody needs a subscription to see their own weekend.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-4 md:gap-6">
      {groups.map((group) => (
        <div class="bg-gray-900 border border-gray-800 rounded-lg p-6">
          <div class="w-12 h-12 bg-gray-800 rounded-lg flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={group.icon} />
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">{group.title}</h3>
          <p class="text-gray-400">{group.text}</p>
        </div>
      ))}
    </div>

    <div class="mt-12 max-w-3xl mx-auto bg-gray-900 border border-gray-800 rounded-lg p-6 text-center">
      <p class="text-gray-400">
        Paddocks have bad network. On the iOS and Android apps, the last season and weekend they loaded{" "}
        <span class="text-white font-medium">still open without a connection</span>, and refresh when the network is back.
      </p>
    </div>
  </div>
</section>
