---
import { Image } from 'astro:assets';
import screenshotSeason from '../../assets/screenshots/crew-app-agenda.png';
import screenshotMonth from '../../assets/screenshots/crew-app-month.png';

const points = [
  {
    title: "Every event, with a countdown",
    text: "The events they are assigned to, with dates, venue and days to go. If you only need them Friday to Saturday, they see their own dates.",
  },
  {
    title: "The days you plan for them",
    text: "Travel, workshop, remote: the days you set in Planning, with your note.",
  },
  {
    title: "Their own days, next to yours",
    text: "Workshop, travel, time off: they add their own days on their phone.",
  },
];
---

<!-- The points on the left, the two views of the season side by side on the right. -->
<section class="band band-paper">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Their whole season, not just this weekend.
      </h2>
      <p class="lede">
        As an agenda or a month, built from your events and{" "}
        <a href="/crew-planning/" class="link">crew planning</a>.
      </p>
    </div>

    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <ul class="flex flex-col gap-10 lg:col-span-5">
        {points.map((point) => (
          <li class="ruled">
            <h3 class="subtitle">{point.title}</h3>
            <p class="muted mt-3 text-lg leading-relaxed">{point.text}</p>
          </li>
        ))}
      </ul>

      <div class="grid grid-cols-2 gap-4 sm:gap-8 lg:col-span-7 lg:pl-6">
        <figure>
          <div class="phone">
            <Image
              src={screenshotSeason}
              alt="RaceNode crew app: a crew member's season as an agenda, workshop days before a race weekend at the Nürburgring"
              widths={[300, 600]}
              sizes="(min-width: 1024px) 18rem, 45vw"
              loading="lazy"
              quality={85}
            />
          </div>
          <figcaption class="mt-3 font-display text-lg font-medium">Agenda</figcaption>
        </figure>
        <figure class="mt-12 sm:mt-20">
          <div class="phone">
            <Image
              src={screenshotMonth}
              alt="RaceNode crew app: a crew member's season as a month, with events, travel and days off"
              widths={[300, 600]}
              sizes="(min-width: 1024px) 18rem, 45vw"
              loading="lazy"
              quality={85}
            />
          </div>
          <figcaption class="mt-3 font-display text-lg font-medium">Month</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
