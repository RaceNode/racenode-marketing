---
import { Image } from 'astro:assets';
import screenshotSeason from '../../assets/screenshots/personal-season.png';
import screenshotMonth from '../../assets/screenshots/personal-month.png';

const points = [
  {
    title: "Every event, with a countdown",
    text: "The events they are assigned to, upcoming and past, with dates, venue and days to go. If you only need them Friday to Saturday, they see their own dates.",
  },
  {
    title: "The days you plan for them",
    text: "Travelling, workshop, remote: the days you set in Planning show up on their side, with your note.",
  },
  {
    title: "Their own days, next to yours",
    text: "Workshop, travel, time off: they add their own days to the same season, on their phone.",
  },
];
---

<section class="px-4 sm:px-6 lg:px-8 py-16 md:py-24 bg-gray-900/30">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Their whole season, not just this weekend.
      </h2>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        The same app shows the season ahead, as an agenda or a month, built from the events and the{" "}
        <a href="/crew-planning/" class="text-gray-300 underline hover:text-white">crew planning</a> you keep for the team.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-4 md:gap-6 mb-12">
      {points.map((point) => (
        <div class="bg-gray-900 border border-gray-800 rounded-lg p-6">
          <h3 class="text-white font-semibold mb-2">{point.title}</h3>
          <p class="text-gray-400">{point.text}</p>
        </div>
      ))}
    </div>

    <div class="flex flex-col sm:flex-row items-start justify-center gap-8 sm:gap-12">
      <div class="w-full max-w-[260px] mx-auto sm:mx-0">
        <div class="rounded-2xl overflow-hidden shadow-2xl border border-gray-700">
          <Image
            src={screenshotSeason}
            alt="RaceNode crew app: a crew member's season as an agenda, travel days around a race weekend at Spa"
            class="w-full h-auto"
            loading="lazy"
            quality={85}
          />
        </div>
        <p class="text-gray-400 text-sm text-center mt-3">Agenda: what is coming, in order.</p>
      </div>
      <div class="w-full max-w-[260px] mx-auto sm:mx-0">
        <div class="rounded-2xl overflow-hidden shadow-2xl border border-gray-700">
          <Image
            src={screenshotMonth}
            alt="RaceNode crew app: a crew member's season as a month, with events, travel and days off"
            class="w-full h-auto"
            loading="lazy"
            quality={85}
          />
        </div>
        <p class="text-gray-400 text-sm text-center mt-3">Month: the shape of the month.</p>
      </div>
    </div>
  </div>
</section>
