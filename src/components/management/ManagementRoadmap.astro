<section class="px-4 sm:px-6 lg:px-8 py-16 md:py-20">
  <div class="max-w-4xl mx-auto">
    <div class="bg-gray-900/50 border border-gray-800 rounded-xl p-8 md:p-10">
      <div class="flex flex-col md:flex-row items-start gap-6">
        <div class="w-14 h-14 bg-amber-900/20 rounded-xl flex items-center justify-center shrink-0 border border-amber-500/30">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-900/20 text-amber-400 rounded-full text-xs font-medium mb-3 border border-amber-500/30">
            New module
          </div>
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
            Timetable is here.
          </h2>
          <p class="text-gray-400 text-lg leading-relaxed mb-4">
