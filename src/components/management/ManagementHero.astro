---
import Shot from '../Shot.astro';
import overviewPhone from '../../assets/screenshots/management-overview-phone.png';
import screenshotOverview from '../../assets/screenshots/management-overview.png';

const appUrl = "https://app.racenode.com";
---

<!-- Opening: the promise on the left, the event overview rising from the track edge. -->
<section class="band-dark overflow-hidden">
  <div class="page pt-14 md:pt-20">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-8">
        <p class="font-display text-lg font-medium text-smoke">
          Management
        </p>

        <h1 class="display mt-5">
          Race team management, structured.
        </h1>
      </div>
      <div class="lg:col-span-4 lg:self-end">
        <p class="lede">
          Roles, cars and meals for every race weekend, set once and seen by the whole crew.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
          <a href={`${appUrl}/signup`} class="btn-primary text-lg">
            Start free
          </a>
          <span class="text-sm text-smoke">Free until 31 December 2026</span>
        </div>
      </div>
    </div>

    <!-- The screen sits on the bottom edge of the band and is cut by it; on a phone, the app's phone screen. -->
    <Shot
      desktop={screenshotOverview}
      phone={overviewPhone}
      alt="RaceNode race team management software dashboard with staff, racecars, teams and meals per event"
      screenClass="-mx-4 mt-14 -mb-2 rounded-b-none sm:mx-0 md:mt-16"
      phoneClass="mt-12 -mb-40"
      sizes="(min-width: 1248px) 1800px, 150vw"
      loading="eager"
    />
  </div>
</section>
<div class="kerb" aria-hidden="true"></div>
