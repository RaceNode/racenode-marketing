---
import StoreBadges from "../StoreBadges.astro";

const examples = [
  { title: 'Car assignment', text: "The mechanic opens their app and sees which car they're working on." },
  { title: 'Role assigned', text: 'The engineer knows their role: Race Engineer on #111 this weekend.' },
  { title: 'Meals visible', text: 'Everyone knows where to eat and when. No need to ask or check emails.' },
];
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Your team sees their assignments instantly.
      </h2>
      <p class="lede">
        Assign once, everyone knows. Management is not a back-office planner. It's a connected system where every team member sees their own assignments in real-time.
      </p>
    </div>

    <!-- Two ends of one line: what the manager sets is what the crew sees. -->
    <div class="grid items-center gap-6 md:grid-cols-[1fr_auto_1fr] md:gap-8">
      <div class="ruled">
        <h3 class="subtitle">Team Manager</h3>
        <p class="mt-2 text-smoke">Assigns roles, cars, and meals in RaceNode</p>
      </div>

      <div class="flex items-center gap-3 md:min-w-56 md:flex-col md:gap-2">
        <span class="h-8 w-px bg-accent-soft md:h-px md:w-full" aria-hidden="true"></span>
        <span class="font-display text-base font-medium whitespace-nowrap text-accent-soft">Instant sync</span>
      </div>

      <div class="ruled">
        <h3 class="subtitle">Staff Member</h3>
        <p class="mt-2 text-smoke">Sees their assignments in the Personal app</p>
      </div>
    </div>

    <ul class="mt-14 grid border-y border-asphalt-line md:grid-cols-3">
      {examples.map(({ title, text }, i) => (
        <li class:list={["py-6 md:px-6", i > 0 && "border-t border-asphalt-line md:border-t-0 md:border-l"]}>
          <h4 class="font-display text-xl font-semibold">{title}</h4>
          <p class="mt-2 text-smoke">{text}</p>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-md">
        <p class="text-smoke">
          No briefing emails to send, no messages to forward, no information lost in transit.
        </p>
        <p class="mt-2 font-medium text-smoke">
          The Personal module is included free with any subscription. Get the app:
        </p>
      </div>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
