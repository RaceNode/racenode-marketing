---
import { m } from '@/paraglide/messages';
import StoreBadges from '../StoreBadges.astro';
import CrewScreen from '../CrewScreen.astro';

const items = [
  {
    label: m.mgmt_sync_role(),
    text: m.mgmt_sync_role_text(),
  },
  { label: m.mgmt_sync_meal(), text: m.mgmt_sync_meal_text() },
  { label: m.common_up_next(), text: m.mgmt_sync_next_text() },
];
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      <h2 class="title">{m.mgmt_sync_title()}</h2>
      <p class="lede">{m.mgmt_sync_lede()}</p>
    </div>

    <CrewScreen screen="top" items={items} />

    <div class="mt-14 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-md font-medium text-smoke">{m.common_crew_gets_app()}</p>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
