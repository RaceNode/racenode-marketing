---
import StoreBadges from "../StoreBadges.astro";
import CrewScreen from "../CrewScreen.astro";

const items = [
  { label: 'My role', text: 'Their roles and their car this weekend: Car Chief on #23, Dead Man in the pit stop crew.' },
  { label: 'Next meal', text: 'Where and when they eat next.' },
  { label: 'Up next', text: "The next item of the event's timetable, with a countdown." },
];
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Your team sees their assignments instantly.
      </h2>
      <p class="lede">
        Every role, car and meal you assign shows up on that person's phone, in the RaceNode app. Here, a chief mechanic's race weekend.
      </p>
    </div>

    <CrewScreen screen="top" items={items} />

    <div class="mt-14 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-md font-medium text-smoke">
        Your crew gets the app on iPhone and Android:
      </p>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
