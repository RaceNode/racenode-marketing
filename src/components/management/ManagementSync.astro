---
import StoreBadges from "../StoreBadges.astro";
import SyncLine from "../SyncLine.astro";

const examples = [
  { title: 'Car assignment', text: "The mechanic opens their app and sees which car they're working on." },
  { title: 'Role assigned', text: 'The engineer knows their role: Race Engineer on #111 this weekend.' },
  { title: 'Meals visible', text: 'Everyone knows where to eat and when. No need to ask or check emails.' },
];
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Your team sees their assignments instantly.
      </h2>
      <p class="lede">
        Assign once, everyone knows. Management is not a back-office planner. It's a connected system where every team member sees their own assignments in real-time.
      </p>
    </div>

    <SyncLine
      from={{ role: "Team Manager", text: "Assigns roles, cars, and meals in RaceNode" }}
      to={{ role: "Staff Member", text: "Sees their assignments in the Personal app" }}
    />

    <ul class="mt-6 grid gap-3 md:grid-cols-3">
      {examples.map(({ title, text }) => (
        <li class="app-card p-5 md:p-6">
          <h4 class="flex items-center gap-2.5 font-display text-xl font-semibold"><span class="ok-dot" aria-hidden="true"></span>{title}</h4>
          <p class="mt-2 text-smoke">{text}</p>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-md">
        <p class="text-smoke">
          No briefing emails to send, no messages to forward, no information lost in transit.
        </p>
        <p class="mt-2 font-medium text-smoke">
          The Personal module is included free with any subscription. Get the app:
        </p>
      </div>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
