---
import { m } from '@/paraglide/messages';
import Shot from '../Shot.astro';
import staff from '../../assets/screenshots/management-event-staff.png';
import staffPhone from '../../assets/screenshots/management-event-staff-phone.png';
import racecars from '../../assets/screenshots/management-racecars.png';
import racecarsPhone from '../../assets/screenshots/management-racecars-phone.png';
import team from '../../assets/screenshots/management-team.png';
import teamPhone from '../../assets/screenshots/management-team-phone.png';
import meals from '../../assets/screenshots/management-meals.png';
import mealsPhone from '../../assets/screenshots/management-meals-phone.png';
import info from '../../assets/screenshots/management-info.png';
import infoPhone from '../../assets/screenshots/management-info-phone.png';

// The screen shows; the words only say what to look at.
const features = [
  {
    desktop: staff,
    phone: staffPhone,
    badge: m.common_badge_event_staff(),
    title: m.mgmt_f1_title(),
    description: m.mgmt_f1_text(),
  },
  {
    desktop: racecars,
    phone: racecarsPhone,
    badge: m.mgmt_badge_racecars(),
    title: m.mgmt_f2_title(),
    description: m.mgmt_f2_text(),
  },
  {
    desktop: team,
    phone: teamPhone,
    badge: m.mgmt_badge_team(),
    title: m.mgmt_f3_title(),
    description: m.mgmt_f3_text(),
  },
  {
    desktop: meals,
    phone: mealsPhone,
    badge: m.mgmt_badge_meals(),
    title: m.mgmt_f4_title(),
    description: m.mgmt_f4_text(),
  },
  {
    desktop: info,
    phone: infoPhone,
    badge: m.common_badge_info_board(),
    title: m.mgmt_f5_title(),
    description: m.mgmt_f5_text(),
  },
];
---

<section class="band band-paper">
  <div class="page">
    <div class="head">
      <h2 class="title">{m.common_every_tool_one_workspace()}</h2>
    </div>

    <!-- One row per tool: the words beside a screen big enough to read, sides alternating. -->
    <div class="space-y-20 md:space-y-28">
      {features.map((feature, index) => (
        <div class="ruled grid items-start gap-8 lg:grid-cols-12 lg:gap-10">
          <div class:list={['lg:col-span-4', index % 2 === 1 && 'lg:order-2 lg:col-start-9']}>
            <p class="font-display text-lg font-medium text-graphite">{feature.badge}</p>
            <h3 class="subtitle mt-2 md:text-3xl">{feature.title}</h3>
            <p class="muted mt-4 text-lg leading-relaxed">{feature.description}</p>
          </div>

          <div
            class:list={[
              'lg:col-span-8',
              index % 2 === 1 && 'lg:order-1 lg:col-start-1 lg:row-start-1',
            ]}
          >
            <Shot
              desktop={feature.desktop}
              phone={feature.phone}
              alt={m.common_feature_alt({ badge: feature.badge, title: feature.title })}
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
