---
import PainList from "../PainList.astro";
import type { IconName } from "../icons";

const painPoints: { title: string; description: string; icon: IconName }[] = [
  {
    title: "Rebuilt from the last one",
    description: "Every weekend, the crew sheet is copied from the last event and fixed by hand: who's on which car, in which role.",
    icon: "refresh",
  },
  {
    title: "Four files, none up to date",
    description: "The crew list, the car roles, the pit stop crew, the meals: each in its own file, and none of them the latest.",
    icon: "files",
  },
];
---

<section class="band">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Every weekend, a new crew sheet.
      </h2>
    </div>

    <PainList points={painPoints} columns={2} />
  </div>
</section>
