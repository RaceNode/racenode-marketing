---
// A season's rounds: a table from sm up, stacked cards on a phone.
import { country, dateRange, roundLabel, roundName } from '../../lib/calendar/format.mjs';

interface Props {
  season: any;
}
const { season } = Astro.props;
---

<ol class="bg-gray-900 border border-gray-800 rounded-lg">
  {season.rounds.map((r: any, i: number) => {
    const label = roundLabel(r) || `Round ${i + 1}`;
    const name = roundName(r);
    return (
      <li class="grid grid-cols-[1fr_auto] sm:grid-cols-[9rem_10.5rem_1fr_auto] gap-x-4 gap-y-1 items-baseline px-4 py-3 border-b border-gray-800 last:border-b-0">
        <span class="text-xs sm:text-sm text-gray-500 col-span-2 sm:col-span-1">{label}</span>
        <span class="font-mono text-sm text-white sm:order-none">
          {dateRange(r.start_date, r.end_date, { withYear: true })}
          {r.status === 'cancelled' && <span class="ml-2 text-xs text-blocking font-sans">Cancelled</span>}
        </span>
        <a
          href={r.url}
          rel="noopener nofollow"
          target="_blank"
          class="text-xs text-gray-400 hover:text-white whitespace-nowrap sm:col-start-4 sm:row-start-1"
        >
          Official page ↗
        </a>
        <span class="text-sm text-gray-300 col-span-2 sm:col-span-1 sm:col-start-3 sm:row-start-1">
          {name && <span class="text-white">{name}<br class="sm:hidden" /><span class="hidden sm:inline"> · </span></span>}
          {r.venue_name}{r.venue_country_code && <span class="text-gray-500">, {country(r.venue_country_code)}</span>}
        </span>
      </li>
    );
  })}
</ol>
