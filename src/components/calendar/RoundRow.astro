---
// One round in the all-championships calendar. The data-* attributes are what the filters read.
import { country, dateRange, monthOf, roundLabel, roundName, DISCIPLINES } from '../../lib/calendar/format.mjs';
import { displayName } from '../../lib/calendar/model.mjs';

interface Props {
  round: any;
}
const { round: r } = Astro.props;
const c = r.championship;
const label = roundLabel(r);
const name = roundName(r);
---

<li
  class="calendar-row grid grid-cols-[5.5rem_1fr] sm:grid-cols-[7rem_14rem_1fr] gap-x-4 gap-y-1 px-4 py-3 border-b border-gray-800 last:border-b-0"
  data-discipline={c.discipline}
  data-region={c.region ?? ''}
  data-month={monthOf(r.start_date)}
  data-year={r.season_year}
>
  <div class="text-sm font-mono text-gray-300 sm:row-span-1 row-span-2">
    {dateRange(r.start_date, r.end_date)}
    {r.status === 'cancelled' && <span class="block text-xs text-blocking font-sans">Cancelled</span>}
  </div>
  <div class="min-w-0">
    <a href={`/calendar/${c.slug}/`} class="text-white font-medium hover:underline">{displayName(c)}</a>
    <span class="block text-xs text-gray-500">{[label, DISCIPLINES[c.discipline]].filter(Boolean).join(' · ')}</span>
  </div>
  <div class="min-w-0 text-sm text-gray-400 sm:col-start-3">
    {name && <span class="text-gray-300">{name} · </span>}
    {r.venue_name}{r.venue_country_code && `, ${country(r.venue_country_code)}`}
  </div>
</li>
