---
// One-line way into the app, right under a calendar page's title. Like CalendarCTA it only invites a team
// to set its season up in RaceNode, it does not promise an import.
import type { Locale } from '@/i18n';
import { appUrl } from '@/lib/app';
import { m } from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';

interface Props {
  /** A championship's name or a circuit's, with `kind` saying which: the sentence differs by language. */
  name: string;
  kind: 'series' | 'circuit';
}
const locale = getLocale() as Locale;
const { name, kind } = Astro.props;
const text = kind === 'series' ? m.cal_inline_series({ name }) : m.cal_inline_circuit({ name });
---

<p class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
  <span>{text}</span>
  <a
    href={appUrl(locale, '/signup')}
    class="link font-semibold"
    data-ph-capture-attribute-cta="calendar-top"
  >
    {m.cal_signup()}
  </a>
</p>
