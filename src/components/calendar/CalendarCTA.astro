---
// The way from a calendar into the app. The app cannot import a catalog season yet (adoption is on its roadmap):
// until it ships, this only invites a team to set its season up in RaceNode, it does not promise an import.
import type { Locale } from '@/i18n';
import { appUrl } from '@/lib/app';
import { m } from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';

interface Props {
  title?: string;
}
const locale = getLocale() as Locale;
const { title = m.cal_cta_title() } = Astro.props;
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-10">
    <div class="lg:col-span-8">
      <h2 class="title">{title}</h2>
      <p class="lede mt-5 max-w-2xl">{m.cal_cta_text()}</p>
    </div>
    <div class="lg:col-span-4 lg:text-right">
      <a
        href={appUrl(locale, '/signup')}
        class="btn-primary text-lg"
        data-ph-capture-attribute-cta="calendar-bottom"
      >
        {m.cal_signup()}
      </a>
    </div>
  </div>
</section>
