---
// Filters of the all-championships calendar. Without JavaScript every upcoming round stays listed; with it, rows,
// meetings, month headings and the "not published yet" list follow the selects, and the choice is kept in the URL. A round
// the visitor's clock says is over is hidden too (the morning build may be a day behind).
import { disciplineName, regionName } from '../../lib/calendar/format.mjs';
import { link, type Locale } from '@/i18n';
import { m } from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';

const locale = getLocale() as Locale;
// The count line the script writes ("12 upcoming rounds across 5 championships"), its pieces in the page's language
// with {n} left for the script to fill.
const text = JSON.stringify({
  roundOne: m.cal_n_upcoming_one({ n: '{n}' }),
  roundOther: m.cal_n_upcoming_other({ n: '{n}' }),
  champOne: m.cal_n_championships_one({ n: '{n}' }),
  champOther: m.cal_n_championships_other({ n: '{n}' }),
  join: m.cal_f_count_join({ rounds: '{rounds}', championships: '{championships}' }),
  circuit: m.cal_f_circuit_calendar({ name: '{name}' }),
  zeroIsOne: locale === 'fr',
});
const circuitsBase = link(locale, 'calendar/circuits');

interface Props {
  disciplines: string[];
  regions: string[];
  /** circuits() of model.mjs that have an upcoming round */
  circuits: { slug: string; venue_slug: string; name: string; page: boolean }[];
  months: { value: string; label: string }[];
}
const { disciplines, regions, circuits, months } = Astro.props;
const select = 'cal-select';
---

<form
  id="calendar-filters"
  class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4"
  aria-label={m.cal_f_label()}
  data-text={text}
>
  <label class="text-xs font-medium text-graphite">
    {m.cal_f_discipline()}
    <select name="discipline" class={select}>
      <option value="">{m.cal_f_all_disciplines()}</option>
      {disciplines.map((d) => (
        <option value={d}>{disciplineName(d, locale)}</option>
      ))}
    </select>
  </label>
  <label class="text-xs font-medium text-graphite">
    {m.cal_f_region()}
    <select name="region" class={select}>
      <option value="">{m.cal_f_all_regions()}</option>
      {regions.map((r) => (
        <option value={r}>{regionName(r, locale)}</option>
      ))}
    </select>
  </label>
  <label class="text-xs font-medium text-graphite">
    {m.cal_f_circuit()}
    <select name="circuit" class={select}>
      <option value="">{m.cal_f_all_circuits()}</option>
      {circuits.map((c) => (
        <option
          value={c.page ? c.slug : c.venue_slug}
          data-page={c.page ? `${circuitsBase}${c.slug}/` : undefined}
        >
          {c.name}
        </option>
      ))}
    </select>
  </label>
  <label class="text-xs font-medium text-graphite">
    {m.cal_f_month()}
    <select name="month" class={select}>
      <option value="">{m.cal_f_all_months()}</option>
      {months.map((m) => (
        <option value={m.value}>{m.label}</option>
      ))}
    </select>
  </label>
</form>
<p id="calendar-count" class="muted text-sm min-h-5 mb-6" aria-live="polite"></p>

<script>
  const form = document.getElementById('calendar-filters') as HTMLFormElement | null;
  const count = document.getElementById('calendar-count');
  const keys = ['discipline', 'region', 'circuit', 'month'] as const;

  function apply() {
    if (!form) return;
    const f = Object.fromEntries(
      keys.map((k) => [k, (form.elements.namedItem(k) as HTMLSelectElement).value]),
    );
    const match = (el: HTMLElement, fields: readonly string[]) =>
      fields.every((k) =>
        !f[k]
          ? true
          : k === 'discipline'
            ? (el.dataset[k] ?? '').split(' ').includes(f[k])
            : el.dataset[k] === f[k],
      );
    const d = new Date();
    const today = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

    let shown = 0;
    const championships = new Set<string>();
    document.querySelectorAll<HTMLElement>('.calendar-row').forEach((row) => {
      const ok = match(row, keys) && !((row.dataset.end ?? '') < today);
      row.hidden = !ok;
      if (ok) {
        shown += 1;
        championships.add(row.querySelector('a')?.getAttribute('href') ?? '');
      }
    });
    // A meeting (a circuit's weekend) whose rounds are all hidden goes too, then a month with nothing left.
    document.querySelectorAll<HTMLElement>('.calendar-meeting').forEach((m) => {
      m.hidden = !m.querySelector('.calendar-row:not([hidden])');
    });
    document.querySelectorAll<HTMLElement>('.calendar-month').forEach((m) => {
      m.hidden = !m.querySelector('.calendar-row:not([hidden])');
    });
    // The championships whose next season is not out have no round to filter by circuit or month.
    const late = document.querySelector<HTMLElement>('#calendar-not-published');
    if (late) {
      let n = 0;
      late.querySelectorAll<HTMLElement>('.calendar-late').forEach((el) => {
        el.hidden = !match(el, ['discipline', 'region']);
        if (!el.hidden) n += 1;
      });
      late.hidden = !n || Boolean(f.circuit || f.month);
    }
    const empty = document.getElementById('calendar-empty');
    if (empty) empty.hidden = shown > 0;
    if (count) {
      const words = JSON.parse(form.dataset.text ?? '{}');
      const plural = (n: number, one: string, other: string) =>
        (n === 1 || (n === 0 && words.zeroIsOne) ? one : other).replace('{n}', String(n));
      count.textContent = words.join
        .replace('{rounds}', plural(shown, words.roundOne, words.roundOther))
        .replace('{championships}', plural(championships.size, words.champOne, words.champOther));
      const circuit = (form.elements.namedItem('circuit') as HTMLSelectElement).selectedOptions[0];
      if (circuit?.dataset.page) {
        const a = document.createElement('a');
        a.href = circuit.dataset.page;
        a.className = 'link';
        a.textContent = words.circuit.replace('{name}', circuit.textContent ?? '');
        count.append(' · ', a);
      }
    }

    const params = new URLSearchParams();
    for (const k of keys) if (f[k]) params.set(k, f[k]);
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  if (form) {
    const params = new URLSearchParams(location.search);
    for (const k of keys) {
      const v = params.get(k);
      const el = form.elements.namedItem(k) as HTMLSelectElement;
      if (v && [...el.options].some((o) => o.value === v)) el.value = v;
    }
    form.addEventListener('change', apply);
    // The browser brought the rounds up to date (LiveRefresh): the new rows follow the current filters too.
    document.addEventListener('calendar:updated', apply);
    apply();
  }
</script>
