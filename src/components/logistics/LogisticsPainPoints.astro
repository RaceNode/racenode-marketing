---
import PainList from "../PainList.astro";
import type { IconName } from "../icons";

const painPoints: { title: string; description: string; icon: IconName }[] = [
  {
    title: "Multiple sources of truth",
    description: "Staff lists, hotel bookings, travel details, vehicle assignments: updated across different files, different channels, different people.",
    icon: "files",
  },
  {
    title: "Information changes constantly",
    description: "A flight gets rescheduled, a room swap is needed, a rental car is added last minute. Every change must reach the right people, every time.",
    icon: "refresh",
  },
  {
    title: "Coordination across roles",
    description: "The logistics coordinator plans. The team manager approves. The mechanics, engineers, and drivers need to know where to go. Keeping everyone aligned takes real effort.",
    icon: "users",
  }
];
---

<section class="band">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Racing team logistics at scale is a coordination challenge.
      </h2>
    </div>

    <PainList points={painPoints} columns={3} />
  </div>
</section>
