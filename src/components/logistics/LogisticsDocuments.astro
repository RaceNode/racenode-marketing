---
import Icon from "../Icon.astro";
---

<section class="band">
  <div class="page grid gap-6 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-6">
      <span class="tile"><Icon name="paperclip" /></span>
      <h2 class="title mt-6">
        Attach it once, access it anywhere.
      </h2>
    </div>
    <p class="lede lg:col-span-6">
      Upload flight tickets, hotel confirmations, or any logistics document directly to the relevant booking. Every assigned staff member can download their documents from the Personal app. No email attachments, no shared drives, no "which version is the latest?"
    </p>
  </div>
</section>
