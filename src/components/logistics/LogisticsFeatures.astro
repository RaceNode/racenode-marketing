---
import { Image } from 'astro:assets';
import screenshotOverview from '../../assets/screenshots/logistics-overview.png';
import screenshotStaff from '../../assets/screenshots/logistics-staff.png';
import screenshotAccommodation from '../../assets/screenshots/logistics-accommodation.png';
import screenshotTravel from '../../assets/screenshots/logistics-travel.png';
import screenshotVehicles from '../../assets/screenshots/logistics-vehicles.png';
import screenshotInfo from '../../assets/screenshots/logistics-info.png';

const screenshots = {
  overview: screenshotOverview,
  staff: screenshotStaff,
  accommodation: screenshotAccommodation,
  travel: screenshotTravel,
  vehicles: screenshotVehicles,
  info: screenshotInfo,
};

const features = [
  {
    id: "overview",
    badge: "Overview",
    title: "See what's missing before it's a problem.",
    description: "A real-time dashboard showing preparation status for each event. Instantly see how many staff members still need a departure flight, a return flight, a hotel room, or an on-site vehicle. Track completion for travel, accommodation and on-site transfers, and get alerts for anything unresolved — dismiss the ones that don't apply so the dashboard reflects reality.",
  },
  {
    id: "staff",
    badge: "Event Staff",
    title: "Your full crew, their complete logistics, one view.",
    description: "See every staff member assigned to the event alongside their travel and accommodation status. Each row shows departure, hotel, return, and on-site vehicle at a glance. Alert icons flag anyone missing a booking — ignore the ones that don't apply. Select several people at once to create a shared trip or hotel in a single action.",
  },
  {
    id: "accommodation",
    badge: "Accommodation",
    title: "Hotels, rooms, and rooming lists. Handled.",
    description: "Add hotels with address auto-complete, then assign staff to rooms in a few clicks. Manage rooming lists per hotel, track room types and capacity, set check-in and check-out details. Attach booking confirmations so your team can download them directly.",
  },
  {
    id: "travel",
    badge: "Travel",
    title: "Every journey planned, every seat assigned.",
    description: "Create departure and return trips for any travel type: flights, cars, trucks, or mixed. Break complex journeys into segments and assign staff to each leg. Attach tickets and documents so every team member has what they need in their pocket.",
  },
  {
    id: "vehicles",
    badge: "Event Vehicles",
    title: "Fleet vehicles and rentals, ready for the road.",
    description: "Pull vehicles from your permanent fleet or add event-specific entries for rentals and loaners. Use them for travel, and assign staff as on-site riders for daily transfers at the circuit — each person rides in one vehicle, sorted in a couple of clicks.",
  },
  {
    id: "info",
    badge: "Info Board",
    title: "The briefing board, shared with everyone.",
    description: "Pin the notes and documents your crew needs — hotel lists, meeting points, schedules, procedures — with the files attached. Everyone assigned to the event sees them read-only in their Personal app, always up to date.",
  }
];
---

<section class="band band-paper">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Six tools, one workspace.
      </h2>
    </div>

    <!-- One row per tool: the words beside a screen big enough to read, sides alternating. -->
    <div class="space-y-20 md:space-y-28">
      {features.map((feature, index) => (
        <div class="ruled grid items-start gap-8 lg:grid-cols-12 lg:gap-10">
          <div class:list={["lg:col-span-4", index % 2 === 1 && "lg:order-2 lg:col-start-9"]}>
            <p class="font-display text-lg font-medium text-graphite">
              {feature.badge}
            </p>
            <h3 class="subtitle mt-2 md:text-3xl">
              {feature.title}
            </h3>
            <p class="muted mt-4 text-lg leading-relaxed">
              {feature.description}
            </p>
          </div>

          <div class:list={["lg:col-span-8", index % 2 === 1 && "lg:order-1 lg:col-start-1 lg:row-start-1"]}>
            <div class="screen">
              <div class="screen-crop">
                <Image
                  src={screenshots[feature.id as keyof typeof screenshots]}
                  alt={`RaceNode ${feature.badge} - ${feature.title}`}
                  widths={[800, 1200, 1800]}
                  sizes="(min-width: 1024px) 1200px, 150vw"
                  loading="lazy"
                  quality={85}
                />
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
