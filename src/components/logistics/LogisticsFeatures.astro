---
import { m } from '@/paraglide/messages';
import Shot from '../Shot.astro';
import staff from '../../assets/screenshots/logistics-staff.png';
import staffPhone from '../../assets/screenshots/logistics-staff-phone.png';
import accommodation from '../../assets/screenshots/logistics-accommodation.png';
import accommodationPhone from '../../assets/screenshots/logistics-accommodation-phone.png';
import travel from '../../assets/screenshots/logistics-travel.png';
import travelPhone from '../../assets/screenshots/logistics-travel-phone.png';
import vehicles from '../../assets/screenshots/logistics-vehicles.png';
import vehiclesPhone from '../../assets/screenshots/logistics-vehicles-phone.png';
import info from '../../assets/screenshots/logistics-info.png';
import infoPhone from '../../assets/screenshots/logistics-info-phone.png';

// The screen shows; the words only say what to look at.
const features = [
  {
    desktop: staff,
    phone: staffPhone,
    badge: m.common_badge_event_staff(),
    title: m.logi_f1_title(),
    description: m.logi_f1_text(),
  },
  {
    desktop: accommodation,
    phone: accommodationPhone,
    badge: m.logi_badge_accommodation(),
    title: m.logi_f2_title(),
    description: m.logi_f2_text(),
  },
  {
    desktop: travel,
    phone: travelPhone,
    badge: m.logi_badge_travel(),
    title: m.logi_f3_title(),
    description: m.logi_f3_text(),
  },
  {
    desktop: vehicles,
    phone: vehiclesPhone,
    badge: m.logi_badge_vehicles(),
    title: m.logi_f4_title(),
    description: m.logi_f4_text(),
  },
  {
    desktop: info,
    phone: infoPhone,
    badge: m.common_badge_info_board(),
    title: m.logi_f5_title(),
    description: m.logi_f5_text(),
  },
];
---

<section class="band band-paper">
  <div class="page">
    <div class="head">
      <h2 class="title">{m.common_every_tool_one_workspace()}</h2>
    </div>

    <!-- One row per tool: the words beside a screen big enough to read, sides alternating. -->
    <div class="space-y-20 md:space-y-28">
      {features.map((feature, index) => (
        <div class="ruled grid items-start gap-8 lg:grid-cols-12 lg:gap-10">
          <div class:list={['lg:col-span-4', index % 2 === 1 && 'lg:order-2 lg:col-start-9']}>
            <p class="font-display text-lg font-medium text-graphite">{feature.badge}</p>
            <h3 class="subtitle mt-2 md:text-3xl">{feature.title}</h3>
            <p class="muted mt-4 text-lg leading-relaxed">{feature.description}</p>
          </div>

          <div
            class:list={[
              'lg:col-span-8',
              index % 2 === 1 && 'lg:order-1 lg:col-start-1 lg:row-start-1',
            ]}
          >
            <Shot
              desktop={feature.desktop}
              phone={feature.phone}
              alt={m.common_feature_alt({ badge: feature.badge, title: feature.title })}
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
