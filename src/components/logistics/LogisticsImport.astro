---
import { m } from '@/paraglide/messages';
import Shot from '../Shot.astro';
import importScreen from '../../assets/screenshots/logistics-import.png';
import importPhone from '../../assets/screenshots/logistics-import-phone.png';
---

<!-- The page's strongest argument, right after the hero: the document creates the booking.
     Shown at the preview, before anything is saved. -->
<section class="band band-paper">
  <div class="page grid items-start gap-8 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-4">
      <p class="font-display text-lg font-medium text-graphite">{m.logi_import_badge()}</p>
      <h2 class="title mt-2">{m.logi_import_title()}</h2>
      <p class="muted mt-5 text-lg leading-relaxed">{m.logi_import_text()}</p>
      <p class="muted mt-4 text-sm leading-relaxed">{m.logi_import_formats()}</p>
    </div>
    <div class="lg:col-span-8">
      <Shot desktop={importScreen} phone={importPhone} alt={m.common_import_alt()} />
    </div>
  </div>
</section>
