---
import StoreBadges from "../StoreBadges.astro";
import SyncLine from "../SyncLine.astro";

const examples = [
  { title: 'Hotel assigned', text: 'The logistics coordinator assigns a hotel room. The mechanic sees it on their phone.' },
  { title: 'Travel updated', text: 'A travel group is updated. The engineer gets the new details instantly.' },
];
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Assign once. Everyone knows.
      </h2>
      <p class="lede">
        This is where Logistics stops being a back-office tool and becomes a connected system. Every accommodation and travel assignment is instantly visible to each staff member through their Personal app.
      </p>
    </div>

    <SyncLine
      from={{ role: "Logistics Coordinator", text: "Assigns accommodation and travel in RaceNode" }}
      to={{ role: "Staff Member", text: "Sees assignments in their Personal app" }}
    />

    <ul class="mt-6 grid gap-3 md:grid-cols-2">
      {examples.map(({ title, text }) => (
        <li class="app-card p-5 md:p-6">
          <h4 class="flex items-center gap-2.5 font-display text-xl font-semibold"><span class="ok-dot" aria-hidden="true"></span>{title}</h4>
          <p class="mt-2 text-smoke">{text}</p>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-md">
        <p class="text-smoke">
          No PDFs to send, no messages to forward, no information lost in transit.
        </p>
        <p class="mt-2 font-medium text-smoke">
          The Personal module is included free with any subscription. Get the app:
        </p>
      </div>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
