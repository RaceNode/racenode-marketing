---
import { m } from '@/paraglide/messages';
import StoreBadges from '../StoreBadges.astro';
import CrewScreen from '../CrewScreen.astro';

const items = [
  {
    label: m.common_my_accommodation(),
    text: m.logi_sync_acc_text(),
  },
  {
    label: m.common_departure_return(),
    text: m.common_departure_return_text(),
  },
  {
    label: m.common_daily_transfer(),
    text: m.logi_sync_daily_text(),
  },
];
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      <h2 class="title">{m.logi_sync_title()}</h2>
      <p class="lede">{m.logi_sync_lede()}</p>
    </div>

    <CrewScreen screen="more" items={items} />

    <div class="mt-14 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-md font-medium text-smoke">{m.common_crew_gets_app()}</p>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
