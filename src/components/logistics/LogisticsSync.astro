---
import StoreBadges from "../StoreBadges.astro";

const examples = [
  { title: 'Hotel assigned', text: 'The logistics coordinator assigns a hotel room. The mechanic sees it on their phone.' },
  { title: 'Travel updated', text: 'A travel group is updated. The engineer gets the new details instantly.' },
];
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Assign once. Everyone knows.
      </h2>
      <p class="lede">
        This is where Logistics stops being a back-office tool and becomes a connected system. Every accommodation and travel assignment is instantly visible to each staff member through their Personal app.
      </p>
    </div>

    <!-- Two ends of one line: what the coordinator sets is what the crew sees. -->
    <div class="grid items-center gap-6 md:grid-cols-[1fr_auto_1fr] md:gap-8">
      <div class="ruled">
        <h3 class="subtitle">Logistics Coordinator</h3>
        <p class="mt-2 text-smoke">Assigns accommodation and travel in RaceNode</p>
      </div>

      <div class="flex items-center gap-3 md:min-w-56 md:flex-col md:gap-2">
        <span class="h-8 w-px bg-accent-soft md:h-px md:w-full" aria-hidden="true"></span>
        <span class="font-display text-base font-medium whitespace-nowrap text-accent-soft">Instant sync</span>
      </div>

      <div class="ruled">
        <h3 class="subtitle">Staff Member</h3>
        <p class="mt-2 text-smoke">Sees assignments in their Personal app</p>
      </div>
    </div>

    <ul class="mt-14 grid border-y border-asphalt-line md:grid-cols-2">
      {examples.map(({ title, text }, i) => (
        <li class:list={["py-6 md:px-6", i > 0 && "border-t border-asphalt-line md:border-t-0 md:border-l"]}>
          <h4 class="font-display text-xl font-semibold">{title}</h4>
          <p class="mt-2 text-smoke">{text}</p>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-md">
        <p class="text-smoke">
          No PDFs to send, no messages to forward, no information lost in transit.
        </p>
        <p class="mt-2 font-medium text-smoke">
          The Personal module is included free with any subscription. Get the app:
        </p>
      </div>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
