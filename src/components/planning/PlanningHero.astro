---
import { Image } from 'astro:assets';
import screenshotOverview from '../../assets/screenshots/planning-overview.png';

const appUrl = "https://app.racenode.com";
---

<!-- Opening: the promise, then the season grid rising from the track edge. -->
<section class="band-dark overflow-hidden">
  <div class="page pt-14 md:pt-20">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-10">
      <div class="lg:col-span-7">
        <p class="font-display text-lg font-medium text-smoke">
          Built by a racing Team Manager
        </p>

        <h1 class="display mt-5">
          The whole season. Who is where, day by day.
        </h1>
      </div>
      <div class="lg:col-span-5">
        <p class="lede">
          Crew planning software for racing teams. Who works which race, across the whole season — staff, racecars, and trucks on one editable grid, with availability posted by your own crew.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
          <a href={`${appUrl}/signup`} class="btn-primary text-lg">
            Get started
          </a>
          <span class="text-sm text-smoke">Free for the 2026 season</span>
        </div>
      </div>
    </div>

    <!-- The whole grid is the point: shown uncropped, cut only by the band edge.
         On a phone, zoomed on the weeks around a race weekend instead. -->
    <div class="screen -mb-16 mt-14 md:-mb-32 md:mt-20">
      <div class="screen-zoom" style="--zoom-x: 0.53; --zoom-y: 0.185; --zoom-aspect: 4 / 5">
        <Image
          src={screenshotOverview}
          alt="RaceNode planning software showing a racing team's whole season on one grid"
          widths={[900, 1400, 2000, 2800]}
          sizes="(min-width: 1248px) 1200px, (min-width: 640px) 100vw, 350vw"
          loading="eager"
          quality={85}
        />
      </div>
    </div>
  </div>
</section>
<div class="kerb" aria-hidden="true"></div>
