---
import { m } from '@/paraglide/messages';
import { appUrl } from '@/lib/app';
import type { Locale } from '@/i18n';
import { getLocale } from '@/paraglide/runtime';
import Shot from '../Shot.astro';
import { CREW_DAYS_IN_PLANNING } from '../../data/crew-days';
import planningPhone from '../../assets/screenshots/planning-phone.png';
import screenshotOverview from '../../assets/screenshots/planning-overview.png';

const locale = getLocale() as Locale;
---

<!-- Opening: the promise, then the season grid rising from the track edge. -->
<section class="band-dark overflow-hidden">
  <div class="page pt-14 md:pt-20">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-start lg:gap-10">
      <div class="lg:col-span-7">
        <p class="font-display text-lg font-medium text-smoke">{m.module_planning_name()}</p>

        <h1 class="display mt-5">{m.plan_hero_title()}</h1>
      </div>
      <div class="lg:col-span-5">
        <p class="lede">
          {m.plan_hero_lede()}
          {CREW_DAYS_IN_PLANNING && m.plan_hero_lede_crew()}.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-5">
          <a href={appUrl(locale, '/signup')} class="btn-primary text-lg">
            {m.common_start_free()}
          </a>
          <span class="text-sm text-smoke sm:min-w-48">{m.common_free_until_short()}</span>
        </div>
      </div>
    </div>

    <!-- The whole grid is the point: shown uncropped, cut only by the band edge.
         On a phone, the app's own phone grid on a race week. -->
    <Shot
      desktop={screenshotOverview}
      phone={planningPhone}
      alt={m.plan_hero_alt()}
      screenClass="-mb-16 mt-14 md:-mb-32 md:mt-20"
      phoneClass="mt-12 -mb-40"
      sizes="(min-width: 1248px) 1200px, 100vw"
      loading="eager"
    />
  </div>
</section>
<div class="kerb" aria-hidden="true"></div>
