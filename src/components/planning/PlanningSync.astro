---
import { Image } from 'astro:assets';
import screenshotAgenda from '../../assets/screenshots/personal-agenda.png';
import screenshotMonth from '../../assets/screenshots/personal-month.png';
---

<section class="px-4 sm:px-6 lg:px-8 py-20 md:py-24 bg-gray-900/30">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Availability flows both ways.
      </h2>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto">
        The grid isn't only written by the manager. Every team member posts their own days from the free Personal app — and what they post lands in your planning.
      </p>
    </div>

    <!-- Sync diagram -->
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-3 gap-6 items-center">
        <!-- Manager side -->
        <div class="bg-gray-900 border border-gray-800 rounded-lg p-6 text-center">
          <div class="w-16 h-16 bg-gray-800 rounded-lg flex items-center justify-center mx-auto mb-4 border border-gray-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="14" x="2" y="3" rx="2"/>
              <line x1="8" x2="16" y1="21" y2="21"/>
              <line x1="12" x2="12" y1="17" y2="21"/>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-2">Team Manager</h3>
          <p class="text-gray-400 text-sm">Assigns events and paints the season in Planning</p>
        </div>

        <!-- Arrow / sync indicator -->
        <div class="flex flex-col items-center justify-center py-4 md:py-0">
          <div class="hidden md:flex items-center gap-2 text-gray-400">
            <div class="w-16 h-0.5 bg-gray-700"></div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 3 4 7l4 4"/>
              <path d="M4 7h16"/>
              <path d="m16 21 4-4-4-4"/>
              <path d="M20 17H4"/>
            </svg>
            <div class="w-16 h-0.5 bg-gray-700"></div>
          </div>
          <div class="md:hidden w-0.5 h-12 bg-gray-700"></div>
          <div class="bg-accent/20 border border-accent/30 rounded-full px-4 py-2 mt-2 md:mt-4">
            <span class="text-white text-sm font-medium">Instant sync</span>
          </div>
        </div>

        <!-- Staff side -->
        <div class="bg-gray-900 border border-gray-800 rounded-lg p-6 text-center">
          <div class="w-16 h-16 bg-gray-800 rounded-lg flex items-center justify-center mx-auto mb-4 border border-gray-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
              <path d="M12 18h.01"/>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-2">Staff Member</h3>
          <p class="text-gray-400 text-sm">Posts their own days in the free Personal app</p>
        </div>
      </div>

      <!-- Example cards -->
      <div class="mt-12 grid md:grid-cols-3 gap-6">
        <div class="bg-gray-900 border border-gray-800 rounded-lg p-5">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-gray-800 rounded-lg flex items-center justify-center shrink-0 border border-gray-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Their days reach you</h4>
              <p class="text-gray-400 text-sm">A member posts a week away and it lands in your grid as unavailable — dates only, their reasons stay their own.</p>
            </div>
          </div>
        </div>

        <div class="bg-gray-900 border border-gray-800 rounded-lg p-5">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-gray-800 rounded-lg flex items-center justify-center shrink-0 border border-gray-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Your days reach them</h4>
              <p class="text-gray-400 text-sm">The days you plan for someone show up in their own season view, with your note — no forwarded screenshots of a spreadsheet.</p>
            </div>
          </div>
        </div>

        <div class="bg-gray-900 border border-gray-800 rounded-lg p-5">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-gray-800 rounded-lg flex items-center justify-center shrink-0 border border-gray-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gray-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Nothing typed twice</h4>
              <p class="text-gray-400 text-sm">Assigning someone to an event in <a href="/management/" class="text-gray-300 underline hover:text-white">Management</a> is the planning entry — track days derive from it, and follow when the event's dates move.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- The other side: what staff see in the Personal app, on their phone -->
      <div class="mt-12 flex flex-col sm:flex-row items-start justify-center gap-8 sm:gap-12">
        <div class="w-full max-w-[280px] mx-auto sm:mx-0">
          <div class="rounded-lg overflow-hidden shadow-2xl border border-gray-700">
            <Image
              src={screenshotAgenda}
              alt="RaceNode Personal app on a phone - a crew member's season in Agenda view"
              class="w-full h-auto"
              loading="lazy"
              quality={85}
            />
          </div>
          <p class="text-gray-400 text-sm text-center mt-3">
            Their side: the season as an agenda — what is coming, in order.
          </p>
        </div>
        <div class="w-full max-w-[280px] mx-auto sm:mx-0">
          <div class="rounded-lg overflow-hidden shadow-2xl border border-gray-700">
            <Image
              src={screenshotMonth}
              alt="RaceNode Personal app on a phone - a crew member's season in Month view"
              class="w-full h-auto"
              loading="lazy"
              quality={85}
            />
          </div>
          <p class="text-gray-400 text-sm text-center mt-3">
            The same season as a month — events, travel, and the days they posted.
          </p>
        </div>
      </div>

      <!-- Note about Personal module -->
      <div class="mt-8 text-center">
        <p class="text-gray-500 text-sm">
          No availability emails to chase, no spreadsheet versions to reconcile.
        </p>
        <p class="text-gray-300 text-sm mt-2 font-medium">
          The Personal module is included free with any subscription.
        </p>
      </div>
    </div>
  </div>
</section>
