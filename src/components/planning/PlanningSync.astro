---
import StoreBadges from "../StoreBadges.astro";
import { Image } from 'astro:assets';
import screenshotAgenda from '../../assets/screenshots/personal-agenda.png';
import screenshotMonth from '../../assets/screenshots/personal-month.png';
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Availability flows both ways.
      </h2>
      <p class="lede">
        The grid isn't only written by the manager. Every team member posts their own days from the free Personal app — and what they post lands in your planning.
      </p>
    </div>

    <!-- Two ends of one line, and this time it runs both ways. -->
    <div class="grid items-center gap-6 md:grid-cols-[1fr_auto_1fr] md:gap-8">
      <div class="ruled">
        <h3 class="subtitle">Team Manager</h3>
        <p class="mt-2 text-smoke">Assigns events and paints the season in Planning</p>
      </div>

      <div class="flex items-center gap-3 md:min-w-56 md:flex-col md:gap-2">
        <span class="h-8 w-px bg-accent-soft md:h-px md:w-full" aria-hidden="true"></span>
        <span class="font-display text-base font-medium whitespace-nowrap text-accent-soft">Instant sync</span>
        <span class="hidden h-px w-full bg-accent-soft md:block" aria-hidden="true"></span>
      </div>

      <div class="ruled">
        <h3 class="subtitle">Staff Member</h3>
        <p class="mt-2 text-smoke">Posts their own days in the free Personal app</p>
      </div>
    </div>

    <ul class="mt-14 grid border-y border-asphalt-line md:grid-cols-3">
      <li class="py-6 md:px-6">
        <h4 class="font-display text-xl font-semibold">Their days reach you</h4>
        <p class="mt-2 text-smoke">A member posts a week away and it lands in your grid as unavailable — dates only, their reasons stay their own.</p>
      </li>
      <li class="border-t border-asphalt-line py-6 md:border-t-0 md:border-l md:px-6">
        <h4 class="font-display text-xl font-semibold">Your days reach them</h4>
        <p class="mt-2 text-smoke">The days you plan for someone show up in their own season view, with your note — no forwarded screenshots of a spreadsheet.</p>
      </li>
      <li class="border-t border-asphalt-line py-6 md:border-t-0 md:border-l md:px-6">
        <h4 class="font-display text-xl font-semibold">Nothing typed twice</h4>
        <p class="mt-2 text-smoke">Assigning someone to an event in <a href="/management/" class="link">Management</a> is the planning entry — track days derive from it, and follow when the event's dates move.</p>
      </li>
    </ul>

    <!-- The other side: what staff see in the Personal app, on their phone -->
    <div class="mt-16 grid gap-12 sm:grid-cols-2 lg:mx-auto lg:max-w-3xl">
      <figure>
        <div class="phone mx-auto w-full max-w-[17rem]">
          <Image
            src={screenshotAgenda}
            alt="RaceNode Personal app on a phone - a crew member's season in Agenda view"
            widths={[340, 680]}
            sizes="17rem"
            loading="lazy"
            quality={85}
          />
        </div>
        <p class="mx-auto mt-4 max-w-[17rem] text-sm text-smoke">
          Their side: the season as an agenda — what is coming, in order.
        </p>
      </figure>
      <figure>
        <div class="phone mx-auto w-full max-w-[17rem]">
          <Image
            src={screenshotMonth}
            alt="RaceNode Personal app on a phone - a crew member's season in Month view"
            widths={[340, 680]}
            sizes="17rem"
            loading="lazy"
            quality={85}
          />
        </div>
        <p class="mx-auto mt-4 max-w-[17rem] text-sm text-smoke">
          The same season as a month — events, travel, and the days they posted.
        </p>
      </figure>
    </div>

    <div class="mt-14 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-md">
        <p class="text-sm text-smoke">
          No availability emails to chase, no spreadsheet versions to reconcile.
        </p>
        <p class="mt-2 font-medium text-smoke">
          The Personal module is included free with any subscription. Get the app:
        </p>
      </div>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
