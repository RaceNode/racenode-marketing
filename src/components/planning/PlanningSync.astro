---
import { m } from '@/paraglide/messages';
import StoreBadges from '../StoreBadges.astro';
import { Image } from 'astro:assets';
import { CREW_DAYS_IN_PLANNING } from '../../data/crew-days';
import screenshotAgenda from '../../assets/screenshots/crew-app-agenda.png';
import screenshotMonth from '../../assets/screenshots/crew-app-month.png';
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      {CREW_DAYS_IN_PLANNING ? (
        <>
          <h2 class="title">{m.plan_sync_title_both()}</h2>
          <p class="lede">{m.plan_sync_lede_both()}</p>
        </>
      ) : (
        <>
          <h2 class="title">{m.plan_sync_title_one()}</h2>
          <p class="lede">{m.plan_sync_lede_one()}</p>
        </>
      )}
    </div>

    <ul
      class:list={['mt-6 grid gap-3', CREW_DAYS_IN_PLANNING ? 'md:grid-cols-3' : 'md:grid-cols-2']}
    >
      {CREW_DAYS_IN_PLANNING && (
        <li class="app-card p-5 md:p-6">
          <h4 class="flex items-center gap-2.5 font-display text-xl font-semibold">
            <span class="ok-dot" aria-hidden="true"></span>
            {m.plan_card_1()}
          </h4>
          <p class="mt-2 text-smoke">{m.plan_card_1_text()}</p>
        </li>
      )}
      <li class="app-card p-5 md:p-6">
        <h4 class="flex items-center gap-2.5 font-display text-xl font-semibold">
          <span class="ok-dot" aria-hidden="true"></span>
          {m.plan_card_2()}
        </h4>
        <p class="mt-2 text-smoke">{m.plan_card_2_text()}</p>
      </li>
      <li class="app-card p-5 md:p-6">
        <h4 class="flex items-center gap-2.5 font-display text-xl font-semibold">
          <span class="ok-dot" aria-hidden="true"></span>
          {m.plan_card_3()}
        </h4>
        <p class="mt-2 text-smoke">{m.plan_card_3_text()}</p>
      </li>
    </ul>

    <!-- The other side: what staff see in Planning (Me view), on their phone -->
    <div class="mt-16 grid gap-12 sm:grid-cols-2 lg:mx-auto lg:max-w-3xl">
      <figure>
        <div class="phone mx-auto w-full max-w-[17rem]">
          <Image
            src={screenshotAgenda}
            alt={m.plan_agenda_alt()}
            widths={[340, 680]}
            sizes="17rem"
            loading="lazy"
            quality={85}
          />
        </div>
        <p class="mx-auto mt-4 max-w-[17rem] text-sm text-smoke">{m.plan_agenda_caption()}</p>
      </figure>
      <figure>
        <div class="phone mx-auto w-full max-w-[17rem]">
          <Image
            src={screenshotMonth}
            alt={m.plan_month_alt()}
            widths={[340, 680]}
            sizes="17rem"
            loading="lazy"
            quality={85}
          />
        </div>
        <p class="mx-auto mt-4 max-w-[17rem] text-sm text-smoke">{m.plan_month_caption()}</p>
      </figure>
    </div>

    <div class="mt-14 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-md">
        {CREW_DAYS_IN_PLANNING && <p class="mb-2 text-sm text-smoke">{m.plan_sync_chase()}</p>}
        <p class="font-medium text-smoke">{m.common_crew_gets_app()}</p>
      </div>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
