---
import { Image } from 'astro:assets';
import screenshotOverview from '../../assets/screenshots/timetable-overview.png';

const appUrl = "https://app.racenode.com";
---

<!-- Opening: the promise, then the schedule itself rising from the track edge. -->
<section class="band-dark overflow-hidden">
  <div class="page pt-14 md:pt-20">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-10">
      <div class="lg:col-span-7">
        <p class="font-display text-lg font-medium text-smoke">
          Built by a racing Team Manager
        </p>

        <h1 class="display mt-5">
          Your race weekend, minute by minute.
        </h1>
      </div>
      <div class="lg:col-span-5">
        <p class="lede">
          The timetable software for racing teams. Build your team's schedule around the official sessions, automate recurring briefings, and share a live countdown screen — everyone knows where to be and when.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
          <a href={`${appUrl}/signup`} class="btn-primary text-lg">
            Get started
          </a>
          <span class="text-sm text-smoke">Free for the 2026 season</span>
        </div>
      </div>
    </div>

    <!-- The screen sits on the bottom edge of the band and is cut by it. -->
    <div class="screen -mb-24 mt-14 md:-mb-40 md:mt-20">
      <div class="screen-crop">
        <Image
          src={screenshotOverview}
          alt="RaceNode timetable software showing a racing team's schedule alongside the official sessions"
          widths={[900, 1400, 2000]}
          sizes="(min-width: 1248px) 1800px, 150vw"
          loading="eager"
          quality={85}
        />
      </div>
    </div>
  </div>
</section>
<div class="kerb" aria-hidden="true"></div>
