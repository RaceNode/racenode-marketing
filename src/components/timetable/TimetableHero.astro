---
import { Image } from 'astro:assets';
import screenshotOverview from '../../assets/screenshots/timetable-overview.png';

const appUrl = "https://app.racenode.com";
---

<section class="px-4 sm:px-6 lg:px-8 py-20 md:py-28">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12 md:mb-16">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-800 text-gray-300 rounded-full text-sm mb-6 border border-gray-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        Built by a racing Team Manager
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
        Your race weekend, minute by minute.
      </h1>
      <p class="text-xl md:text-2xl text-gray-400 max-w-3xl mx-auto mb-8">
        The timetable software for racing teams. Build your team's schedule around the official sessions, automate recurring briefings, and share a live countdown screen — everyone knows where to be and when.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={`${appUrl}/signup`}
          class="bg-amber-600 hover:bg-amber-700 text-white px-8 py-3 rounded-lg text-lg font-medium transition-colors"
        >
          Get started
        </a>
        <span class="text-gray-500 text-sm">Free for the 2026 season</span>
      </div>
    </div>

    <!-- Screenshot -->
    <div class="max-w-5xl mx-auto rounded-xl overflow-hidden shadow-2xl shadow-amber-500/10">
      <Image
        src={screenshotOverview}
        alt="RaceNode timetable software showing a racing team's schedule alongside the official sessions"
        class="w-full h-auto"
        quality={85}
      />
    </div>
  </div>
</section>
