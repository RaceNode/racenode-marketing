---
import { m } from '@/paraglide/messages';
import Shot from '../Shot.astro';
import schedule from '../../assets/screenshots/timetable-schedule.png';
import schedulePhone from '../../assets/screenshots/timetable-day-phone.png';
import items from '../../assets/screenshots/timetable-items.png';
import itemsPhone from '../../assets/screenshots/timetable-items-phone.png';
import rules from '../../assets/screenshots/timetable-rules.png';
import rulesPhone from '../../assets/screenshots/timetable-rules-phone.png';
import importScreen from '../../assets/screenshots/timetable-import.png';
import importPhone from '../../assets/screenshots/timetable-import-phone.png';

// The screen shows; the words only say what to look at.
const features = [
  {
    desktop: schedule,
    phone: schedulePhone,
    badge: m.tt_badge_schedule(),
    title: m.tt_f1_title(),
    description: m.tt_f1_text(),
  },
  {
    desktop: items,
    phone: itemsPhone,
    badge: m.tt_badge_templates(),
    title: m.tt_f2_title(),
    description: m.tt_f2_text(),
  },
  {
    desktop: rules,
    phone: rulesPhone,
    badge: m.tt_badge_rules(),
    title: m.tt_f3_title(),
    description: m.tt_f3_text(),
  },
  {
    desktop: importScreen,
    phone: importPhone,
    badge: m.logi_import_badge(),
    title: m.tt_f4_title(),
    description: m.tt_f4_text(),
    small: m.tt_f4_small(),
  },
];
---

<section class="band band-paper">
  <div class="page">
    <div class="head">
      <h2 class="title">{m.tt_features_title()}</h2>
    </div>

    <div class="space-y-20 md:space-y-28">
      {features.map((feature, index) => (
        <div class="ruled grid gap-8 lg:grid-cols-12 lg:gap-10">
          <!-- Content -->
          <div class:list={['lg:col-span-4', index % 2 === 1 && 'lg:order-2 lg:col-start-9']}>
            <p class="font-display text-lg font-medium text-graphite">{feature.badge}</p>
            <h3 class="subtitle mt-2 md:text-4xl">{feature.title}</h3>
            <p class="muted mt-4 text-lg leading-relaxed">{feature.description}</p>
            {feature.small && <p class="muted mt-4 text-sm leading-relaxed">{feature.small}</p>}
          </div>

          <!-- Screenshot -->
          <div
            class:list={[
              'lg:col-span-8',
              index % 2 === 1 && 'lg:order-1 lg:col-start-1 lg:row-start-1',
            ]}
          >
            <Shot
              desktop={feature.desktop}
              phone={feature.phone}
              alt={m.tt_feature_alt({ badge: feature.badge, title: feature.title })}
              sizes="(min-width: 1024px) 820px, 100vw"
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
