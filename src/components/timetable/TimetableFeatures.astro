---
import { Image } from 'astro:assets';
import screenshotSchedule from '../../assets/screenshots/timetable-schedule.png';
import screenshotItems from '../../assets/screenshots/timetable-items.png';
import screenshotRules from '../../assets/screenshots/timetable-rules.png';
import screenshotOfficial from '../../assets/screenshots/timetable-official.png';
import screenshotShare from '../../assets/screenshots/timetable-share.png';

const screenshots = {
  schedule: screenshotSchedule,
  items: screenshotItems,
  rules: screenshotRules,
  official: screenshotOfficial,
  share: screenshotShare,
};

const features = [
  {
    id: "schedule",
    badge: "Team Timetable",
    title: "Your schedule, next to the official one.",
    description: "Lay out your team's plan alongside the organizer's sessions. Read it as a clean, PDF-style table with collapsible days, or flip to a calendar view to drag and resize items. Every entry is color-coded by type, with a live indicator on the current time. Export to Excel or CSV in one click."
  },
  {
    id: "items",
    badge: "Item Templates",
    title: "Build once, reuse every weekend.",
    description: "Save your recurring entries — track walk, engineering briefing, pit setup, departure to circuit — as org-level templates with a type, location, and duration. Start typing on the schedule and it autocompletes, pre-fills the details, and computes the end time for you."
  },
  {
    id: "rules",
    badge: "Automation Rules",
    title: "Anchor to the sessions. Let the rest follow.",
    description: "Define a rule once — \"engineering briefing, 45 minutes before every practice\" — and generate the derived items across the weekend. Preview the exact times before you run it, re-run safely without duplicates, and see a badge on every synced item. Change the official session and your plan keeps up."
  },
  {
    id: "official",
    badge: "Official Timetable",
    title: "The organizer's schedule, always in view.",
    description: "The official sessions from the Events module sit right beside your team plan — same data, no re-entry. Your internal schedule articulates around the real timetable instead of drifting away from it."
  },
  {
    id: "share",
    badge: "Share Links",
    title: "One link for the whole paddock.",
    description: "Publish a tokenized public link per event — an iCal feed staff subscribe to, or a big-screen display page with a live countdown to every session. Revoke it anytime. Countdowns run on the circuit's timezone, so a TV in the box and a phone in another country both show the right time."
  }
];
---

<section class="band band-paper">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Five tools, one schedule.
      </h2>
    </div>

    <div class="space-y-20 md:space-y-28">
      {features.map((feature, index) => (
        <div class="ruled grid gap-8 lg:grid-cols-12 lg:gap-10">
          <!-- Content -->
          <div class:list={["lg:col-span-4", index % 2 === 1 && "lg:order-2 lg:col-start-9"]}>
            <p class="font-display text-lg font-medium text-graphite">
              {feature.badge}
            </p>
            <h3 class="subtitle mt-2 md:text-4xl">
              {feature.title}
            </h3>
            <p class="muted mt-4 text-lg leading-relaxed">
              {feature.description}
            </p>
          </div>

          <!-- Screenshot -->
          <div class:list={["lg:col-span-8", index % 2 === 1 && "lg:order-1 lg:col-start-1 lg:row-start-1"]}>
            <div class="screen">
              <Image
                src={screenshots[feature.id as keyof typeof screenshots]}
                alt={`RaceNode Timetable ${feature.badge} - ${feature.title}`}
                widths={[800, 1200, 1600]}
                sizes="(min-width: 1024px) 820px, 100vw"
                loading="lazy"
                quality={85}
              />
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Boundary with Planning: Timetable is inside an event, Planning between events -->
    <div class="hair mt-20 pt-6 md:mt-28">
      <p class="max-w-3xl text-lg leading-relaxed text-graphite">
        The Timetable covers the race weekend <span class="font-semibold text-ink">inside an event</span>, minute by minute, anchored to the official sessions.
        Across the season — availability, and who works which race — that's the
        <a href="/crew-planning/" class="link">Planning module</a>.
      </p>
    </div>
  </div>
</section>
