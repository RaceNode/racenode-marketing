---
import { m } from '@/paraglide/messages';
import Shot from '../Shot.astro';
import screenshotBox from '../../assets/screenshots/timetable-box.png';

const points = [m.tt_share_1(), m.tt_share_2(), m.tt_share_3()];
---

<section class="band">
  <div class="page grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-10">
    <!-- Text -->
    <div class="lg:col-span-5">
      <h2 class="title">{m.tt_share_title()}</h2>
      <p class="lede mt-5">{m.tt_share_lede()}</p>
      <ul class="mt-8">
        {points.map((point) => (
          <li class="hair py-3 leading-snug">{point}</li>
        ))}
      </ul>
    </div>

    <!-- Screenshot: the wall screen, shown big; whole on a phone too. -->
    <div class="lg:col-span-7">
      <Shot
        desktop={screenshotBox}
        alt={m.tt_share_alt()}
        sizes="(min-width: 1024px) 720px, 100vw"
      />
    </div>
  </div>
</section>
