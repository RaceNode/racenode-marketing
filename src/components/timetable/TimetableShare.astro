---
import { Image } from 'astro:assets';
import screenshotBox from '../../assets/screenshots/timetable-box.png';
---

<section class="px-4 sm:px-6 lg:px-8 py-16 md:py-20">
  <div class="max-w-6xl mx-auto">
    <div class="bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden">
      <div class="grid lg:grid-cols-2 items-center">
        <!-- Text -->
        <div class="p-8 md:p-12">
          <div class="w-14 h-14 bg-amber-900/20 rounded-xl flex items-center justify-center mb-6 border border-amber-500/30">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="14" x="2" y="3" rx="2"/>
              <line x1="8" x2="16" y1="21" y2="21"/>
              <line x1="12" x2="12" y1="17" y2="21"/>
            </svg>
          </div>
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">
            Put the countdown on the wall.
          </h2>
          <p class="text-gray-400 text-lg leading-relaxed mb-6">
            Cast a public display page to the TV in your box: every session with a live countdown, updating on its own. Or hand out an iCal link the whole team subscribes to once. Timezone comes from the circuit, so the screen is right whether you're at Le Mans or watching from home.
          </p>
          <ul class="space-y-3">
            <li class="flex items-start gap-2 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              <span class="text-gray-300">Big-screen display with live per-session countdowns</span>
            </li>
            <li class="flex items-start gap-2 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              <span class="text-gray-300">iCal feed for phones and calendar apps</span>
            </li>
            <li class="flex items-start gap-2 text-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              <span class="text-gray-300">One link per event, revoke it anytime</span>
            </li>
          </ul>
        </div>

        <!-- Screenshot -->
        <div class="h-full min-h-[280px] bg-gray-950/50 p-6 md:p-8 flex items-center">
          <div class="rounded-xl overflow-hidden shadow-2xl shadow-amber-500/10 w-full">
            <Image
              src={screenshotBox}
              alt="RaceNode public timetable display with live countdowns to each session"
              class="w-full h-auto"
              loading="lazy"
              quality={85}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
