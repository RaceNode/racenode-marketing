---
import Shot from '../Shot.astro';
import screenshotBox from '../../assets/screenshots/timetable-box.png';

const points = [
  'Big-screen display with live per-session countdowns',
  'iCal feed for phones and calendar apps',
  'One link per event, revoke it anytime',
];
---

<section class="band">
  <div class="page grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-10">
    <!-- Text -->
    <div class="lg:col-span-5">
      <h2 class="title">
        Put the countdown on the wall.
      </h2>
      <p class="lede mt-5">
        Cast a public display page to the TV in your box: every session with a live countdown, updating on its own. Or hand out an iCal link the whole team subscribes to once. Timezone comes from the circuit, so the screen is right whether you're at Le Mans or watching from home.
      </p>
      <ul class="mt-8">
        {points.map((point) => (
          <li class="hair py-3 leading-snug">{point}</li>
        ))}
      </ul>
    </div>

    <!-- Screenshot: the wall screen, shown big; whole on a phone too. -->
    <div class="lg:col-span-7">
      <Shot desktop={screenshotBox} alt="RaceNode public timetable display with live countdowns to each session" sizes="(min-width: 1024px) 720px, 100vw" />
    </div>
  </div>
</section>
