---
import StoreBadges from "../StoreBadges.astro";

const examples = [
  { title: 'Up next', text: 'Each member sees the next sessions of the day, rolling over automatically as the weekend runs.' },
  { title: 'Always current', text: 'A schedule change reaches everyone instantly. No new PDF to resend, no "which version is this?".' },
  { title: 'No more questions', text: 'The mechanic knows the setup window, the engineer knows the briefing time. Nobody has to ask.' },
];
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Everyone sees what's next, in real time.
      </h2>
      <p class="lede">
        Update the schedule once, and every team member sees it. The Timetable isn't a back-office planner — it's a live plan each person carries in their own app.
      </p>
    </div>

    <!-- Two ends of one line: what the manager sets is what the crew sees. -->
    <div class="grid items-center gap-6 md:grid-cols-[1fr_auto_1fr] md:gap-8">
      <div class="ruled">
        <h3 class="subtitle">Team Manager</h3>
        <p class="mt-2 text-smoke">Builds the schedule in RaceNode</p>
      </div>

      <div class="flex items-center gap-3 md:min-w-56 md:flex-col md:gap-2">
        <span class="h-8 w-px bg-accent-soft md:h-px md:w-full" aria-hidden="true"></span>
        <span class="font-display text-base font-medium whitespace-nowrap text-accent-soft">Instant sync</span>
      </div>

      <div class="ruled">
        <h3 class="subtitle">Staff Member</h3>
        <p class="mt-2 text-smoke">Sees the "Up next" plan in the Personal app</p>
      </div>
    </div>

    <ul class="mt-14 grid border-y border-asphalt-line md:grid-cols-3">
      {examples.map(({ title, text }, i) => (
        <li class:list={["py-6 md:px-6", i > 0 && "border-t border-asphalt-line md:border-t-0 md:border-l"]}>
          <h4 class="font-display text-xl font-semibold">{title}</h4>
          <p class="mt-2 text-smoke">{text}</p>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-md">
        <p class="text-sm text-smoke">
          No schedule PDFs to send, no messages to forward, no session missed.
        </p>
        <p class="mt-2 font-medium text-smoke">
          The Personal module is included free with any subscription. Get the app:
        </p>
      </div>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
