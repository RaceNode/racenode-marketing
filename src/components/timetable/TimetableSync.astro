---
import StoreBadges from "../StoreBadges.astro";
import CrewScreen from "../CrewScreen.astro";

const items = [
  { label: 'Up next', text: 'The next items of the day with a countdown, rolling over on its own as the weekend runs.' },
  { label: 'View all', text: 'One tap opens the whole timetable.' },
  { label: 'Always current', text: 'Change the schedule once: the phones show the new time, no new PDF to send.' },
];
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page">
    <div class="head">
      <h2 class="title">
        Everyone sees what's next, in real time.
      </h2>
      <p class="lede">
        The timetable you build is the one each person carries in the RaceNode app. Here, a chief mechanic's race weekend.
      </p>
    </div>

    <CrewScreen screen="top" items={items} crop={[0.095, 0.24]} />

    <div class="mt-14 flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-md font-medium text-smoke">
        Your crew gets the app on iPhone and Android:
      </p>
      <StoreBadges align="start" />
    </div>
  </div>
</section>
