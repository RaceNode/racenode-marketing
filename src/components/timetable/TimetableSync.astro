---

---

<section class="px-4 sm:px-6 lg:px-8 py-20 md:py-24 bg-gray-900/30">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Everyone sees what's next, in real time.
      </h2>
      <p class="text-xl text-gray-400 max-w-3xl mx-auto">
        Update the schedule once, and every team member sees it. The Timetable isn't a back-office planner — it's a live plan each person carries in their own app.
      </p>
    </div>

    <!-- Sync diagram -->
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-3 gap-6 items-center">
        <!-- Manager side -->
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 text-center">
          <div class="w-16 h-16 bg-amber-900/20 rounded-xl flex items-center justify-center mx-auto mb-4 border border-amber-500/30">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="14" x="2" y="3" rx="2"/>
              <line x1="8" x2="16" y1="21" y2="21"/>
              <line x1="12" x2="12" y1="17" y2="21"/>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-2">Team Manager</h3>
          <p class="text-gray-400 text-sm">Builds the schedule in RaceNode</p>
        </div>

        <!-- Arrow / sync indicator -->
        <div class="flex flex-col items-center justify-center py-4 md:py-0">
          <div class="hidden md:flex items-center gap-2 text-amber-400">
            <div class="w-16 h-0.5 bg-gradient-to-r from-amber-600 to-amber-400"></div>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"/>
              <path d="m12 5 7 7-7 7"/>
            </svg>
            <div class="w-16 h-0.5 bg-gradient-to-r from-amber-400 to-amber-600"></div>
          </div>
          <div class="md:hidden w-0.5 h-12 bg-gradient-to-b from-amber-600 via-amber-400 to-amber-600"></div>
          <div class="bg-amber-900/20 border border-amber-500/30 rounded-full px-4 py-2 mt-2 md:mt-4">
            <span class="text-amber-300 text-sm font-medium">Instant sync</span>
          </div>
        </div>

        <!-- Staff side -->
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 text-center">
          <div class="w-16 h-16 bg-gray-800 rounded-xl flex items-center justify-center mx-auto mb-4 border border-gray-700">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-gray-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
              <path d="M12 18h.01"/>
            </svg>
          </div>
          <h3 class="text-white font-semibold mb-2">Staff Member</h3>
          <p class="text-gray-400 text-sm">Sees the "Up next" plan in the Personal app</p>
        </div>
      </div>

      <!-- Example cards -->
      <div class="mt-12 grid md:grid-cols-3 gap-6">
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-amber-900/20 rounded-lg flex items-center justify-center shrink-0 border border-amber-500/30">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Up next</h4>
              <p class="text-gray-400 text-sm">Each member sees the next sessions of the day, rolling over automatically as the weekend runs.</p>
            </div>
          </div>
        </div>

        <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-amber-900/20 rounded-lg flex items-center justify-center shrink-0 border border-amber-500/30">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">Always current</h4>
              <p class="text-gray-400 text-sm">A schedule change reaches everyone instantly. No new PDF to resend, no "which version is this?".</p>
            </div>
          </div>
        </div>

        <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-amber-900/20 rounded-lg flex items-center justify-center shrink-0 border border-amber-500/30">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-medium mb-1">No more questions</h4>
              <p class="text-gray-400 text-sm">The mechanic knows the setup window, the engineer knows the briefing time. Nobody has to ask.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Note about Personal module -->
      <div class="mt-8 text-center">
        <p class="text-gray-500 text-sm">
          No schedule PDFs to send, no messages to forward, no session missed.
        </p>
        <p class="text-amber-400 text-sm mt-2 font-medium">
          The Personal module is included free with any subscription.
        </p>
      </div>
    </div>
  </div>
</section>
