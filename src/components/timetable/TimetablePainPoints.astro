---
const painPoints = [
  {
    title: "Rebuilt in Excel every weekend",
    description: "A new spreadsheet for every event, copied from the last one, out of date the moment the official schedule shifts.",
    icon: "table"
  },
  {
    title: "Briefings lost in the group chat",
    description: "Setup windows, briefings, and departure times sent by message — then buried under the next fifty notifications.",
    icon: "message"
  },
  {
    title: "Out of sync with the official schedule",
    description: "Your internal plan lives apart from the organizer's timetable, so a session change never propagates to your team.",
    icon: "unlink"
  },
  {
    title: "\"When's my session again?\"",
    description: "Everyone asking the same questions all weekend because there's no single, live view of the plan.",
    icon: "help"
  }
];

const icons: Record<string, string> = {
  table: `<path d="M12 3v18"/><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/>`,
  message: `<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>`,
  unlink: `<path d="m18.84 12.25 1.72-1.71h-.02a5.004 5.004 0 0 0-.12-7.07 5.006 5.006 0 0 0-6.95 0l-1.72 1.71"/><path d="m5.17 11.75-1.71 1.71a5.004 5.004 0 0 0 .12 7.07 5.006 5.006 0 0 0 6.95 0l1.71-1.71"/><line x1="8" x2="8" y1="2" y2="5"/><line x1="2" x2="5" y1="8" y2="8"/><line x1="16" x2="16" y1="19" y2="22"/><line x1="19" x2="22" y1="16" y2="16"/>`,
  help: `<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>`
};
---

<section class="px-4 sm:px-6 lg:px-8 py-20 md:py-24 bg-gray-900/30">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        The schedule is the plan. Yet it lives everywhere but one place.
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {painPoints.map((point) => (
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-gray-700 transition-colors">
          <div class="w-12 h-12 bg-gray-800 rounded-lg flex items-center justify-center mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-6 h-6 text-gray-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={icons[point.icon]}
            />
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">{point.title}</h3>
          <p class="text-gray-400">{point.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
