---
import { m } from '@/paraglide/messages';
import PainList from '../PainList.astro';
import type { IconName } from '../icons';

const painPoints: { title: string; description: string; icon: IconName }[] = [
  {
    title: m.tt_pain_1_title(),
    description: m.tt_pain_1_text(),
    icon: 'table',
  },
  {
    title: m.tt_pain_2_title(),
    description: m.tt_pain_2_text(),
    icon: 'message',
  },
  {
    title: m.tt_pain_3_title(),
    description: m.tt_pain_3_text(),
    icon: 'help',
  },
];
---

<section class="band">
  <div class="page">
    <div class="head">
      <h2 class="title">{m.tt_pain_title()}</h2>
    </div>

    <PainList points={painPoints} columns={3} />
  </div>
</section>
