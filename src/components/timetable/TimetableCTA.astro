---
import { m } from '@/paraglide/messages';
import { appUrl } from '@/lib/app';
import type { Locale } from '@/i18n';
import { getLocale } from '@/paraglide/runtime';
const locale = getLocale() as Locale;
---

<div class="kerb" aria-hidden="true"></div>
<section class="band band-dark">
  <div class="page grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-10">
    <div class="lg:col-span-8">
      <h2 class="title">{m.tt_cta_title()}</h2>
      <p class="lede mt-5 max-w-2xl">{m.common_free_until_cta()}</p>
    </div>
    <div class="lg:col-span-4 lg:text-right">
      <a href={appUrl(locale, '/signup')} class="btn-primary text-lg">
        {m.common_start_free()}
      </a>
    </div>
  </div>
</section>
