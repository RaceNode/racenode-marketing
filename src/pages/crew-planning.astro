---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { breadcrumbJsonLd } from '../lib/seo';
import { site } from '../site.config';
import PlanningHero from '../components/planning/PlanningHero.astro';
import PlanningPainPoints from '../components/planning/PlanningPainPoints.astro';
import PlanningFeatures from '../components/planning/PlanningFeatures.astro';
import PlanningSync from '../components/planning/PlanningSync.astro';
import PlanningCTA from '../components/planning/PlanningCTA.astro';

const title = 'Crew Planning & Season Scheduling for Race Teams | RaceNode';
const description =
  'Plan who works which race across the season. Crew availability, rotas and staffing for motorsport teams, connected to every event on the calendar.';

const breadcrumbSchema = breadcrumbJsonLd(site, [
  { name: 'Home', url: '/' },
  { name: 'Crew Planning', url: '/crew-planning/' },
]);
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <PlanningHero />
      <PlanningPainPoints />
      <PlanningFeatures />
      <PlanningSync />
      <PlanningCTA />
    </main>
    <Footer />
  </div>
</BaseLayout>
