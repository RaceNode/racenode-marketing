---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ManagementHero from '../components/management/ManagementHero.astro';
import ManagementPainPoints from '../components/management/ManagementPainPoints.astro';
import ManagementFeatures from '../components/management/ManagementFeatures.astro';
import ManagementSync from '../components/management/ManagementSync.astro';
import ManagementCTA from '../components/management/ManagementCTA.astro';

const title = "Race Weekend & Crew Management Software | RaceNode";
const description = "Plan every race weekend in one place: crew assignments and roles, racecar entries, team structure and meals. Event management built for racing teams.";

// JSON-LD BreadcrumbList schema for SEO
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.racenode.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Race Team Management",
      "item": "https://www.racenode.com/management/"
    }
  ]
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-gray-950">
    <Header />
    <main>
      <ManagementHero />
      <ManagementPainPoints />
      <ManagementFeatures />
      <ManagementSync />
      <ManagementCTA />
    </main>
    <Footer />
  </div>
</BaseLayout>
