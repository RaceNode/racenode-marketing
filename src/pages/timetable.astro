---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { breadcrumbJsonLd } from '../lib/seo';
import { site } from '../site.config';
import TimetableHero from '../components/timetable/TimetableHero.astro';
import TimetablePainPoints from '../components/timetable/TimetablePainPoints.astro';
import TimetableFeatures from '../components/timetable/TimetableFeatures.astro';
import TimetableSync from '../components/timetable/TimetableSync.astro';
import TimetableShare from '../components/timetable/TimetableShare.astro';
import TimetableCTA from '../components/timetable/TimetableCTA.astro';

const title = 'Race Weekend Timetable & Schedule Software | RaceNode';
const description =
  "Build your team's schedule around the official timetable, automate recurring briefings, and share a live countdown and iCal feed with the whole team.";

const breadcrumbSchema = breadcrumbJsonLd(site, [
  { name: 'Home', url: '/' },
  { name: 'Motorsport Timetable', url: '/timetable/' },
]);
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <TimetableHero />
      <TimetablePainPoints />
      <TimetableFeatures />
      <TimetableSync />
      <TimetableShare />
      <TimetableCTA />
    </main>
    <Footer />
  </div>
</BaseLayout>
