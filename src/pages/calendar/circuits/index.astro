---
// Every circuit that has its own calendar page, by country: the way in to /calendar/circuits/<slug>/ for visitors
// and search engines. Built each morning with the rest; nothing here is refreshed in the browser.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CalendarCTA from '../../../components/calendar/CalendarCTA.astro';
import SampleDataNotice from '../../../components/calendar/SampleDataNotice.astro';
import { catalog } from '../../../lib/calendar/build.mjs';
import { circuits } from '../../../lib/calendar/model.mjs';

const { data, ctx, cal } = await catalog();
const pages = circuits(cal).filter((c: any) => c.page);
const byCountry = new Map<string, any[]>();
for (const c of pages) {
  const name = c.country_code ? ctx.countries[c.country_code] ?? c.country_code : 'Other';
  if (!byCountry.has(name)) byCountry.set(name, []);
  byCountry.get(name)!.push(c);
}
const countries = [...byCountry].sort(([a], [b]) => a.localeCompare(b));
const upcoming = (c: any) => c.rounds.filter((r: any) => r.end_date >= ctx.today).length;

const title = `Motorsport Calendar ${cal.year} by Circuit: Every Race at Each Track | RaceNode`;
const description = `${pages.length} circuits, one page each: which championships race there in ${cal.year} and when. Dates as each organizer publishes them.`;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.racenode.com" },
    { "@type": "ListItem", "position": 2, "name": "Motorsport Calendar", "item": "https://www.racenode.com/calendar/" },
    { "@type": "ListItem", "position": 3, "name": "Circuits", "item": "https://www.racenode.com/calendar/circuits/" },
  ],
};
---

<BaseLayout title={title} description={description} noindex={data.sample}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-gray-950">
    <Header />
    <main class="px-4 sm:px-6 lg:px-8 pt-10 md:pt-14">
      <div class="max-w-5xl mx-auto">
        {data.sample && <SampleDataNotice />}

        <nav class="text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
          <a href="/calendar/" class="hover:text-white">Motorsport calendar</a>
          <span class="mx-1">/</span>
          <span class="text-gray-400">Circuits</span>
        </nav>

        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">Race calendars by circuit</h1>
        <p class="text-lg text-gray-400 max-w-3xl mb-10">
          Every championship racing at a circuit, on one page, in date order. Dates as each organizer publishes them.
        </p>

        {countries.map(([country, list]) => (
          <section class="mb-8">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-400 mb-2">{country}</h2>
            <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2">
              {list.map((c: any) => (
                <li>
                  <a href={`/calendar/circuits/${c.slug}/`} class="block bg-gray-900 border border-gray-800 hover:border-gray-700 rounded-lg px-4 py-3 transition-colors">
                    <span class="text-white font-medium">{c.name}</span>
                    <span class="block text-xs text-gray-500">{upcoming(c) ? `${upcoming(c)} upcoming round${upcoming(c) === 1 ? "" : "s"}` : 'No upcoming round published yet'}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}

        <p class="mt-10 text-sm text-gray-500">
          <a href="/calendar/" class="underline hover:text-white">All championships on one calendar</a>
        </p>
      </div>
      <CalendarCTA />
    </main>
    <Footer />
  </div>
</BaseLayout>
