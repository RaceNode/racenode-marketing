---
// One page per circuit with enough rounds in the catalog (circuits() of model.mjs), for searches such as
// "Spa-Francorchamps 2027 calendar": every championship's upcoming rounds there, in date order. The visitor's
// browser brings that part up to date (LiveRefresh); the other circuits listed wait for the next build.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CalendarCTA from '../../../components/calendar/CalendarCTA.astro';
import SampleDataNotice from '../../../components/calendar/SampleDataNotice.astro';
import LiveRefresh from '../../../components/calendar/LiveRefresh.astro';
import { catalog, liveConfig } from '../../../lib/calendar/build.mjs';
import { circuits, displayName } from '../../../lib/calendar/model.mjs';
import { circuitBody, hash } from '../../../lib/calendar/render.mjs';

export async function getStaticPaths() {
  const { cal } = await catalog();
  return circuits(cal)
    .filter((c) => c.page)
    .map((c) => ({ params: { circuit: c.slug } }));
}

const loaded = await catalog();
const { data, ctx, cal } = loaded;
const all = circuits(cal);
const c = all.find((x: any) => x.slug === Astro.params.circuit)!;
const place = c.country_code ? ctx.countries[c.country_code] ?? c.country_code : null;
const year = cal.year;
const body = circuitBody(cal, c.slug, ctx);
const upcoming = c.rounds.filter((r: any) => r.end_date >= ctx.today);
const championships = [...new Map(upcoming.map((r: any) => [r.championship.slug, r.championship])).values()];
const names = championships.map((x: any) => displayName(x));
const nearby = all.filter((x: any) => x.page && x.slug !== c.slug && x.country_code === c.country_code);

const title = `${c.name} ${year} Calendar: Every Race & Date | RaceNode`;
const description = upcoming.length
  ? `${upcoming.length} upcoming rounds at ${c.name}${place ? `, ${place}` : ''}: ${names.slice(0, 4).join(', ')}${names.length > 4 ? ' and more' : ''}. Dates as each organizer publishes them, with links to the official pages.`
  : `Which championships race at ${c.name}${place ? `, ${place}` : ''}: the rounds published so far and the ones already run, with links to the official pages.`;

const url = `https://www.racenode.com/calendar/circuits/${c.slug}/`;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.racenode.com" },
    { "@type": "ListItem", "position": 2, "name": "Motorsport Calendar", "item": "https://www.racenode.com/calendar/" },
    { "@type": "ListItem", "position": 3, "name": "Circuits", "item": "https://www.racenode.com/calendar/circuits/" },
    { "@type": "ListItem", "position": 4, "name": c.name, "item": url },
  ],
};
// The rounds as facts: dates, place, official page. No logo, no image.
const eventsSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `${c.name} race calendar`,
  "itemListElement": upcoming.map((r: any, i: number) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "SportsEvent",
      "name": `${r.championship.name} – ${r.name}`,
      "startDate": r.start_date,
      "endDate": r.end_date,
      "eventStatus": r.status === 'cancelled' ? "https://schema.org/EventCancelled" : "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "url": r.url,
      "location": {
        "@type": "Place",
        "name": c.name,
        ...(c.country_code && { "address": { "@type": "PostalAddress", "addressCountry": c.country_code } }),
      },
      ...(r.championship.organizer_name && { "organizer": { "@type": "Organization", "name": r.championship.organizer_name, ...(r.championship.organizer_website_url && { "url": r.championship.organizer_website_url }) } }),
    },
  })),
};
---

<BaseLayout title={title} description={description} noindex={data.sample}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {upcoming.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(eventsSchema)} />}
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <section class="band-dark cal-open">
        <div class="page">
        {data.sample && <SampleDataNotice />}

        <nav class="cal-crumbs" aria-label="Breadcrumb">
          <a href="/calendar/">Motorsport calendar</a>
          <span class="mx-1">/</span>
          <a href="/calendar/circuits/">Circuits</a>
          <span class="mx-1">/</span>
          <span aria-current="page">{c.name}</span>
        </nav>

        <h1 class="display">{c.name} {year} calendar</h1>
        {place && <p class="lede mt-6">Circuit · {place}</p>}
        </div>
      </section>
      <div class="kerb" aria-hidden="true"></div>

      <section class="cal-body">
        <div class="page">

        <div data-calendar-live="body" data-hash={hash(body)} set:html={body} />

        {nearby.length > 0 && (
          <section class="mt-12">
            <h2 class="subtitle mb-4">Other circuits in {place}</h2>
            <ul class="flex flex-wrap gap-2">
              {nearby.map((x: any) => (
                <li>
                  <a href={`/calendar/circuits/${x.slug}/`} class="cal-chip">{x.name}</a>
                </li>
              ))}
            </ul>
          </section>
        )}

        <p class="mt-10 text-sm">
          <a href="/calendar/" class="link">All championships on one calendar</a>
          <span class="mx-1">·</span>
          <a href="/calendar/circuits/" class="link">All circuits</a>
        </p>
        </div>
      </section>
      <CalendarCTA title={`Racing at ${c.name}? Plan your season in RaceNode.`} />
    </main>
    <Footer />
  </div>
  <LiveRefresh config={liveConfig(loaded, { circuit: c.slug })} />
</BaseLayout>
