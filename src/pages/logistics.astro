---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LogisticsHero from '../components/logistics/LogisticsHero.astro';
import LogisticsPainPoints from '../components/logistics/LogisticsPainPoints.astro';
import LogisticsFeatures from '../components/logistics/LogisticsFeatures.astro';
import LogisticsSync from '../components/logistics/LogisticsSync.astro';
import LogisticsImport from '../components/logistics/LogisticsImport.astro';
import LogisticsCTA from '../components/logistics/LogisticsCTA.astro';

const title = "Race Team Travel & Accommodation Software | RaceNode";
const description = "Manage crew travel, flights, hotels and room allocation for every race weekend. People logistics for racing teams — not freight.";

// JSON-LD BreadcrumbList schema for SEO
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.racenode.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Race Team Travel & Accommodation",
      "item": "https://www.racenode.com/logistics/"
    }
  ]
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <LogisticsHero />
      <LogisticsImport />
      <LogisticsPainPoints />
      <LogisticsFeatures />
      <LogisticsSync />
      <LogisticsCTA />
    </main>
    <Footer />
  </div>
</BaseLayout>
