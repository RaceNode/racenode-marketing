---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LandingHero from '../components/landing/LandingHero.astro';
import LandingProblem from '../components/landing/LandingProblem.astro';
import LandingSolution from '../components/landing/LandingSolution.astro';
import LandingModules from '../components/landing/LandingModules.astro';
import LandingSync from '../components/landing/LandingSync.astro';
import LandingCredibility from '../components/landing/LandingCredibility.astro';
import LandingCTA from '../components/landing/LandingCTA.astro';
---

<BaseLayout
  title="Racing Team Management Software | RaceNode"
  description="Travel, hotels, roles and the race weekend timetable, on every crew member's phone. Built by a former GT3 team manager. Free until 31 December 2026."
>
  <div class="min-h-screen bg-concrete flex flex-col">
    <Header />
    <main class="flex-1">
      <LandingHero />
      <LandingProblem />
      <LandingSolution />
      <LandingModules />
      <LandingSync />
      <LandingCredibility />
      <LandingCTA />
    </main>
    <Footer />
  </div>
</BaseLayout>
