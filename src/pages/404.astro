---
// Served by Cloudflare Pages with a real 404 status for any unknown URL.
// Without it, Pages falls back to the home page with a 200, so every typo
// or dead link is indexed as a duplicate of the home page.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Page not found | RaceNode" noindex>
  <div class="min-h-screen bg-gray-950">
    <Header />
    <main class="px-4 sm:px-6 lg:px-8 py-32">
      <div class="max-w-2xl mx-auto text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">Page not found</h1>
        <p class="text-lg text-gray-400 mb-8">This page does not exist or has moved.</p>
        <a
          href="/"
          class="inline-block bg-accent hover:bg-accent-hover text-white px-8 py-3 rounded-lg text-lg font-semibold transition-colors"
        >
          Back to the home page
        </a>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
