---
// Served by Cloudflare Pages with a real 404 status for any unknown URL.
// Without it, Pages falls back to the home page with a 200, so every typo
// or dead link is indexed as a duplicate of the home page.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Page not found | RaceNode" noindex>
  <div class="min-h-screen bg-concrete">
    <Header />
    <main class="band band-dark">
      <div class="page">
        <h1 class="display">Page not found</h1>
        <p class="lede mt-6 max-w-xl">This page does not exist or has moved.</p>
        <a href="/" class="btn-primary mt-10 text-lg">
          Back to the home page
        </a>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
