---
import { m } from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';
import { link, localePathsOf, type Locale } from '@/i18n';

export const getStaticPaths = () => localePathsOf('logistics');
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { breadcrumbJsonLd } from '@/lib/seo';
import { site } from '@/site.config';
import LogisticsHero from '@/components/logistics/LogisticsHero.astro';
import LogisticsPainPoints from '@/components/logistics/LogisticsPainPoints.astro';
import LogisticsFeatures from '@/components/logistics/LogisticsFeatures.astro';
import LogisticsSync from '@/components/logistics/LogisticsSync.astro';
import LogisticsImport from '@/components/logistics/LogisticsImport.astro';
import LogisticsCTA from '@/components/logistics/LogisticsCTA.astro';

const locale = getLocale() as Locale;
const title = m.logi_title();
const description = m.logi_description();

const breadcrumbSchema = breadcrumbJsonLd(site, [
  { name: m.common_breadcrumb_home(), url: link(locale, '') },
  { name: m.logi_breadcrumb(), url: link(locale, 'logistics') },
]);
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <LogisticsHero />
      <LogisticsImport />
      <LogisticsPainPoints />
      <LogisticsFeatures />
      <LogisticsSync />
      <LogisticsCTA />
    </main>
    <Footer />
  </div>
</BaseLayout>
