---
import { m } from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';
import { link, localePathsOf, type Locale } from '@/i18n';

export const getStaticPaths = () => localePathsOf('timetable');
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { breadcrumbJsonLd } from '@/lib/seo';
import { site } from '@/site.config';
import TimetableHero from '@/components/timetable/TimetableHero.astro';
import TimetablePainPoints from '@/components/timetable/TimetablePainPoints.astro';
import TimetableFeatures from '@/components/timetable/TimetableFeatures.astro';
import TimetableSync from '@/components/timetable/TimetableSync.astro';
import TimetableShare from '@/components/timetable/TimetableShare.astro';
import TimetableCTA from '@/components/timetable/TimetableCTA.astro';

const locale = getLocale() as Locale;
const title = m.tt_title();
const description = m.tt_description();

const breadcrumbSchema = breadcrumbJsonLd(site, [
  { name: m.common_breadcrumb_home(), url: link(locale, '') },
  { name: m.tt_breadcrumb(), url: link(locale, 'timetable') },
]);
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <TimetableHero />
      <TimetablePainPoints />
      <TimetableFeatures />
      <TimetableSync />
      <TimetableShare />
      <TimetableCTA />
    </main>
    <Footer />
  </div>
</BaseLayout>
