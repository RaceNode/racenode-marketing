---
import { m } from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';
import { link, localePathsOf, type Locale } from '@/i18n';

export const getStaticPaths = () => localePathsOf('management');
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { breadcrumbJsonLd } from '@/lib/seo';
import { site } from '@/site.config';
import ManagementHero from '@/components/management/ManagementHero.astro';
import ManagementPainPoints from '@/components/management/ManagementPainPoints.astro';
import ManagementFeatures from '@/components/management/ManagementFeatures.astro';
import ManagementSync from '@/components/management/ManagementSync.astro';
import ManagementCTA from '@/components/management/ManagementCTA.astro';

const locale = getLocale() as Locale;
const title = m.mgmt_title();
const description = m.mgmt_description();

const breadcrumbSchema = breadcrumbJsonLd(site, [
  { name: m.common_breadcrumb_home(), url: link(locale, '') },
  { name: m.mgmt_breadcrumb(), url: link(locale, 'management') },
]);
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <ManagementHero />
      <ManagementPainPoints />
      <ManagementFeatures />
      <ManagementSync />
      <ManagementCTA />
    </main>
    <Footer />
  </div>
</BaseLayout>
