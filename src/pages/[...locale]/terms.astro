---
import { localePathsOf } from '@/i18n';

export const getStaticPaths = () => localePathsOf('terms');
import LegalLayout from '@/layouts/LegalLayout.astro';
import { legalText } from '@/data/legal';
import { getLocale } from '@/paraglide/runtime';
import { m } from '@/paraglide/messages';

const Content = legalText('terms-and-conditions.md', getLocale());
---

<LegalLayout
  title={m.legal_terms_title()}
  description={m.legal_terms_description()}
  heading={m.legal_terms_heading()}
>
  <Content />
</LegalLayout>
