---
import { localePathsOf } from '@/i18n';

export const getStaticPaths = () => localePathsOf('pricing');
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { breadcrumbJsonLd, faqJsonLd } from '@/lib/seo';
import { site } from '@/site.config';
import { modules } from '@/data/modules';
import { href } from '@/i18n';
import { appUrl } from '@/lib/app';
import { getLocale } from '@/paraglide/runtime';
import { m } from '@/paraglide/messages';

// Prices and wording: Willi, 2026-10-26. Free for everyone until 31 December 2026; from 2027 a free trial that
// lasts until the end of the team's first event (any kind of event), then a subscription. Simple, factual, no slogan.
// The French wording is the one in the messages (pricing_*), approved separately.
const locale = getLocale();
const title = m.pricing_title();
const description = m.pricing_description();

const faq = [
  { q: m.pricing_q_cost(), a: m.pricing_a_cost() },
  { q: m.pricing_q_trial(), a: m.pricing_a_trial() },
  { q: m.pricing_q_after(), a: m.pricing_a_after() },
  { q: m.pricing_q_2026(), a: m.pricing_a_2026() },
];

const breadcrumbSchema = breadcrumbJsonLd(site, [
  { name: m.pricing_breadcrumb_home(), url: href(locale) },
  { name: m.pricing_breadcrumb_pricing(), url: href(locale, 'pricing') },
]);

const faqSchema = faqJsonLd(
  site,
  href(locale, 'pricing'),
  faq.map((item) => ({ question: item.q, answer: item.a })),
);
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <!-- Opening, as on the module pages: the page's name, the trial, then the price on the band itself. -->
      <section class="band band-dark">
        <div class="page grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-10">
          <div class="lg:col-span-7">
            <p class="font-display text-lg font-medium text-smoke">{m.pricing_eyebrow()}</p>
            <h1 class="display mt-5">{m.pricing_heading()}</h1>
          </div>
          <div class="lg:col-span-5 lg:pt-12">
            <p class="flex items-baseline gap-3">
              <span class="display">{m.pricing_price()}</span>
              <span class="lede">{m.pricing_per_month()}</span>
            </p>
            <p class="lede mt-2">{m.pricing_per_year()}</p>
            <p class="mt-3 text-smoke">{m.pricing_scope()}</p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
              <a href={appUrl(locale, '/signup')} class="btn-primary text-lg">
                {m.pricing_cta()}
              </a>
              <span class="text-sm text-smoke">{m.pricing_no_card()}</span>
            </div>
            <p class="hair mt-8 pt-5 text-fog">{m.pricing_free_2026()}</p>
          </div>
        </div>
      </section>
      <div class="kerb" aria-hidden="true"></div>

      <!-- What the price covers: the four modules, from the same data as the header menu. -->
      <section class="band">
        <div class="page">
          <div class="head">
            <h2 class="title">{m.pricing_modules_heading()}</h2>
          </div>
          <ul class="grid gap-x-12 gap-y-10 md:grid-cols-2">
            {modules().map((module) => (
              <li>
                <a href={module.href} class="group block">
                  <h3 class="ruled font-display text-2xl font-bold">{module.name}</h3>
                  <p class="muted mt-3 max-w-xl leading-relaxed">{module.short}</p>
                  <span class="link mt-3 inline-block decoration-transparent group-hover:decoration-current">
                    {m.pricing_see_module({ name: module.name })} <span aria-hidden="true">→</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- FAQ -->
      <section class="band band-paper">
        <div class="page grid gap-10 lg:grid-cols-12 lg:gap-10">
          <h2 class="title lg:col-span-4">{m.pricing_faq_heading()}</h2>
          <div class="lg:col-span-8">
            {faq.map((item) => (
              <div class="hair py-6">
                <h3 class="font-display text-xl font-semibold">{item.q}</h3>
                <p class="muted mt-2 max-w-2xl text-lg leading-relaxed">{item.a}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
