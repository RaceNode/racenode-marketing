---
import { m } from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';
import { link, localePathsOf, type Locale } from '@/i18n';

export const getStaticPaths = () => localePathsOf('crew-planning');
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { breadcrumbJsonLd } from '@/lib/seo';
import { site } from '@/site.config';
import PlanningHero from '@/components/planning/PlanningHero.astro';
import PlanningPainPoints from '@/components/planning/PlanningPainPoints.astro';
import PlanningFeatures from '@/components/planning/PlanningFeatures.astro';
import PlanningSync from '@/components/planning/PlanningSync.astro';
import PlanningCTA from '@/components/planning/PlanningCTA.astro';

const locale = getLocale() as Locale;
const title = m.plan_title();
const description = m.plan_description();

const breadcrumbSchema = breadcrumbJsonLd(site, [
  { name: m.common_breadcrumb_home(), url: link(locale, '') },
  { name: m.plan_breadcrumb(), url: link(locale, 'crew-planning') },
]);
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <PlanningHero />
      <PlanningPainPoints />
      <PlanningFeatures />
      <PlanningSync />
      <PlanningCTA />
    </main>
    <Footer />
  </div>
</BaseLayout>
