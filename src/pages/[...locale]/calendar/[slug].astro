---
// One page per championship, built each morning at a stable URL (the catalog's series slug), for searches such as
// "GT World Challenge Europe 2027 calendar". When the organizer has not published the featured season yet,
// the page says so and shows the last season known, instead of an empty page. The visitor's browser then brings
// the season part up to date (LiveRefresh); the rest (same weekends, related) waits for the next build.
import { absoluteUrl, hasPrefix, link, localePathsOf, type Locale } from '@/i18n';
import { m } from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CalendarCTA from '@/components/calendar/CalendarCTA.astro';
import CalendarInlineCTA from '@/components/calendar/CalendarInlineCTA.astro';
import SampleDataNotice from '@/components/calendar/SampleDataNotice.astro';
import LiveRefresh from '@/components/calendar/LiveRefresh.astro';
import { catalog, liveConfig, localized } from '@/lib/calendar/build.mjs';
import { displayName, sharedWeekends } from '@/lib/calendar/model.mjs';
import { championshipBody, hash, logoOf } from '@/lib/calendar/render.mjs';
import { disciplineName, regionName } from '@/lib/calendar/format.mjs';

export async function getStaticPaths() {
  const { cal } = await catalog();
  return cal.championships.flatMap((c: any) =>
    localePathsOf(`calendar/${c.slug}`, [{ slug: c.slug }]),
  );
}

const locale = getLocale() as Locale;
const loaded = await catalog();
const { data, cal } = loaded;
const calendarBase = link(locale, 'calendar');
const ctx = localized(loaded, locale, calendarBase);
const homeUrl = hasPrefix(locale)
  ? absoluteUrl(link(locale))
  : absoluteUrl(link(locale)).replace(/\/$/, '');
const c = cal.championships.find((x: any) => x.slug === (Astro.params as { slug: string }).slug)!;
const logo = logoOf(c.slug, ctx, { large: true }).replace('loading="lazy"', 'loading="eager"');
const shown = c.shown;
const year = cal.year;
const organizer = c.organizer_name ?? m.cal_the_organizer();
const body = championshipBody(cal, c.slug, ctx);
const shared = sharedWeekends(cal, c).slice(0, 8);
const related = cal.championships
  .filter(
    (x: any) =>
      x.slug !== c.slug &&
      x.discipline === c.discipline &&
      shared.every((s) => s.championship.slug !== x.slug),
  )
  .slice(0, 8);
const facts = [
  disciplineName(c.discipline, locale),
  c.region && regionName(c.region, locale),
  c.country_code && (ctx.countries[c.country_code] ?? c.country_code),
].filter(Boolean);

const venues = [...new Set(shown.rounds.map((r: any) => r.venue_name))];
const title = c.featured
  ? m.cal_series_title({ name: c.name, year })
  : m.cal_series_title_late({ name: c.name, year });
const description = c.featured
  ? m.cal_series_description({
      name: c.name,
      label: shown.label,
      n: shown.rounds.length,
      venues: venues.slice(0, 4).join(', '),
      more: venues.length > 4 ? m.cal_and_more() : '',
      organizer,
    })
  : m.cal_series_description_late({
      organizer,
      name: c.name,
      year,
      label: shown.label,
      n: shown.rounds.length,
    });

const url = absoluteUrl(`${calendarBase}${c.slug}/`);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: m.cal_crumb_home(), item: homeUrl },
    {
      '@type': 'ListItem',
      position: 2,
      name: m.cal_crumb_calendar(),
      item: absoluteUrl(calendarBase),
    },
    { '@type': 'ListItem', position: 3, name: c.name, item: url },
  ],
};
// The rounds as facts: dates, place, official page (no image in the structured data).
const eventsSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: m.cal_schema_calendar({ name: c.name, label: shown.label }),
  itemListElement: shown.rounds.map((r: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SportsEvent',
      name: `${c.name} – ${r.name}`,
      startDate: r.start_date,
      endDate: r.end_date,
      eventStatus:
        r.status === 'cancelled'
          ? 'https://schema.org/EventCancelled'
          : 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      url: r.url,
      location: {
        '@type': 'Place',
        name: r.venue_name,
        ...(r.venue_country_code && {
          address: { '@type': 'PostalAddress', addressCountry: r.venue_country_code },
        }),
      },
      ...(c.organizer_name && {
        organizer: {
          '@type': 'Organization',
          name: c.organizer_name,
          ...(c.organizer_website_url && { url: c.organizer_website_url }),
        },
      }),
    },
  })),
};
---

<BaseLayout title={title} description={description} noindex={data.sample}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(eventsSchema)} />
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <section class="band-dark cal-open">
        <div class="page">
          {data.sample && <SampleDataNotice />}

          <nav class="cal-crumbs" aria-label={m.cal_crumb_label()}>
            <a href={calendarBase}>{m.cal_crumb_calendar_nav()}</a>
            <span class="mx-1">/</span>
            <span aria-current="page">{displayName(c)}</span>
          </nav>

          {logo && <div class="mb-6" set:html={logo} />}
          <h1 class="display">{m.cal_series_h1({ name: c.name, year })}</h1>
          <p class="lede mt-6 max-w-3xl">
            {facts.join(' · ')}
            {c.organizer_name && (
              <>
                {' '}
                · {m.cal_organized_by()}{' '}
                {c.organizer_website_url ? (
                  <a
                    href={c.organizer_website_url}
                    rel="noopener nofollow"
                    target="_blank"
                    class="link"
                  >
                    {c.organizer_name}
                  </a>
                ) : (
                  c.organizer_name
                )}
              </>
            )}
          </p>
          <CalendarInlineCTA name={displayName(c)} kind="series" />
        </div>
      </section>
      <div class="kerb" aria-hidden="true"></div>

      <section class="cal-body">
        <div class="page">
          <div data-calendar-live="body" data-hash={hash(body)} set:html={body} />

          {shared.length > 0 && (
            <section class="mt-12">
              <h2 class="subtitle mb-2">{m.cal_same_weekends()}</h2>
              <p class="muted text-sm mb-4">{m.cal_same_weekends_text({ label: shown.label })}</p>
              <ul class="flex flex-wrap gap-2">
                {shared.map((s) => (
                  <li>
                    <a href={`${calendarBase}${s.championship.slug}/`} class="cal-chip">
                      {displayName(s.championship)}{' '}
                      <span class="text-graphite">
                        ·{' '}
                        {s.count === 1
                          ? m.cal_weekend_one({ n: s.count })
                          : m.cal_weekend_other({ n: s.count })}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {related.length > 0 && (
            <section class="mt-10">
              <h2 class="subtitle mb-4">
                {m.cal_other_calendars({ discipline: disciplineName(c.discipline, locale) })}
              </h2>
              <ul class="flex flex-wrap gap-2">
                {related.map((x: any) => (
                  <li>
                    <a href={`${calendarBase}${x.slug}/`} class="cal-chip">
                      {displayName(x)}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <p class="mt-10 text-sm">
            <a href={calendarBase} class="link">
              {m.cal_all_championships()}
            </a>
          </p>
        </div>
      </section>
      <CalendarCTA title={m.cal_cta_series_title({ name: displayName(c) })} />
    </main>
    <Footer />
  </div>
  <LiveRefresh config={liveConfig({ data, ctx }, { slug: c.slug })} />
</BaseLayout>
