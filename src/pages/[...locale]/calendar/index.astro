---
import { absoluteUrl, hasPrefix, link, localePathsOf, localeTag, type Locale } from '@/i18n';
import { m } from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';

export const getStaticPaths = () => localePathsOf('calendar');
// Every championship's upcoming rounds on one chronological page, built each morning from the catalog; the
// morning build only (no browser refresh: that is for championship pages). Filters run in the browser.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CalendarFilters from '@/components/calendar/CalendarFilters.astro';
import CalendarCTA from '@/components/calendar/CalendarCTA.astro';
import SampleDataNotice from '@/components/calendar/SampleDataNotice.astro';
import { catalog, localized } from '@/lib/calendar/build.mjs';
import { circuits, notPublished, upcomingRounds } from '@/lib/calendar/model.mjs';
import { indexBody, indexSummary } from '@/lib/calendar/render.mjs';
import { DISCIPLINES, REGIONS, monthName } from '@/lib/calendar/format.mjs';

const locale = getLocale() as Locale;
const loaded = await catalog();
const { data, cal } = loaded;
const calendarBase = link(locale, 'calendar');
const ctx = localized(loaded, locale, calendarBase);
const homeUrl = hasPrefix(locale)
  ? absoluteUrl(link(locale))
  : absoluteUrl(link(locale)).replace(/\/$/, '');
const upcoming = upcomingRounds(cal, ctx.today);
const months = [...new Set(upcoming.map((r: any) => r.start_date.slice(0, 7)))].map((mo) => ({
  value: mo,
  label: `${monthName(Number(mo.slice(5)), locale)} ${mo.slice(0, 4)}`,
}));
const allCircuits = circuits(cal);
const upcomingCircuits = allCircuits.filter((c: any) =>
  c.rounds.some((r: any) => r.end_date >= ctx.today),
);
// The busiest circuits here; every circuit page is on /calendar/circuits/.
const circuitPages = allCircuits
  .filter((c: any) => c.page)
  .sort((a: any, b: any) => b.rounds.length - a.rounds.length)
  .slice(0, 24)
  .sort((a: any, b: any) => a.name.localeCompare(b.name, localeTag(locale)));
const thisYear = Number(ctx.today.slice(0, 4));
const span = thisYear === cal.year ? `${cal.year}` : `${thisYear}–${cal.year}`;
const disciplines = Object.keys(DISCIPLINES).filter((d) =>
  cal.championships.some((c: any) => (c.disciplines ?? [c.discipline]).includes(d)),
);
const regions = Object.keys(REGIONS).filter((r) =>
  cal.championships.some((c: any) => c.region === r),
);
const summary = indexSummary(cal, ctx);
const body = indexBody(cal, ctx);

const title = m.cal_index_title({ year: cal.year });
const published = cal.championships.length - notPublished(cal).length;
const description = m.cal_index_description({
  total: cal.championships.length,
  published,
  year: cal.year,
});

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: m.cal_crumb_home(), item: homeUrl },
    {
      '@type': 'ListItem',
      position: 2,
      name: m.cal_crumb_calendar(),
      item: absoluteUrl(calendarBase),
    },
  ],
};
---

<BaseLayout title={title} description={description} noindex={data.sample}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <section class="band-dark cal-open">
        <div class="page">
          {data.sample && <SampleDataNotice />}

          <h1 class="display">{m.cal_index_h1({ span })}</h1>
          <p class="lede mt-6 max-w-3xl">{m.cal_index_lede({ n: cal.championships.length })}</p>
          <p class="mt-4 max-w-3xl text-sm text-smoke">
            <span set:html={summary} /> {m.cal_index_checked()}
          </p>
        </div>
      </section>
      <div class="kerb" aria-hidden="true"></div>

      <section class="cal-body">
        <div class="page">
          <CalendarFilters
            disciplines={disciplines}
            regions={regions}
            circuits={upcomingCircuits}
            months={months}
          />

          <div set:html={body} />

          <p class="muted mt-8 text-sm">{m.cal_index_past()}</p>

          <section class="mt-12">
            <h2 class="subtitle mb-2">{m.cal_index_by_circuit()}</h2>
            <p class="muted mb-4">{m.cal_index_by_circuit_text()}</p>
            <ul class="flex flex-wrap gap-2">
              {circuitPages.map((c: any) => (
                <li>
                  <a href={`${link(locale, 'calendar/circuits')}${c.slug}/`} class="cal-chip">
                    {c.name}
                  </a>
                </li>
              ))}
            </ul>
            <p class="mt-4 text-sm">
              <a href={link(locale, 'calendar/circuits')} class="link">
                {m.cal_all_circuits()}
              </a>
            </p>
          </section>
        </div>
      </section>
      <CalendarCTA title={m.cal_cta_index_title()} />
    </main>
    <Footer />
  </div>
</BaseLayout>
