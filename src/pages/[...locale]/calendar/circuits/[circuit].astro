---
import { absoluteUrl, hasPrefix, link, localePathsOf, type Locale } from '@/i18n';
import { m } from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';
// One page per circuit with enough rounds in the catalog (circuits() of model.mjs), for searches such as
// "Spa-Francorchamps 2027 calendar": every championship's upcoming rounds there, in date order. Morning build only
// (no browser refresh: that is for championship pages).
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CalendarCTA from '@/components/calendar/CalendarCTA.astro';
import CalendarInlineCTA from '@/components/calendar/CalendarInlineCTA.astro';
import SampleDataNotice from '@/components/calendar/SampleDataNotice.astro';
import { catalog, localized } from '@/lib/calendar/build.mjs';
import { circuits, displayName } from '@/lib/calendar/model.mjs';
import { circuitBody } from '@/lib/calendar/render.mjs';

export async function getStaticPaths() {
  const { cal } = await catalog();
  return circuits(cal)
    .filter((c) => c.page)
    .flatMap((c) => localePathsOf(`calendar/circuits/${c.slug}`, [{ circuit: c.slug }]));
}

const locale = getLocale() as Locale;
const loaded = await catalog();
const { data, cal } = loaded;
const calendarBase = link(locale, 'calendar');
const circuitsBase = link(locale, 'calendar/circuits');
const ctx = localized(loaded, locale, calendarBase);
const homeUrl = hasPrefix(locale)
  ? absoluteUrl(link(locale))
  : absoluteUrl(link(locale)).replace(/\/$/, '');
const all = circuits(cal);
const c = all.find(
  (x: any) => x.slug === (Astro.params as unknown as { circuit: string }).circuit,
)!;
const place = c.country_code ? (ctx.countries[c.country_code] ?? c.country_code) : null;
const year = cal.year;
const body = circuitBody(cal, c.slug, ctx);
const upcoming = c.rounds.filter((r: any) => r.end_date >= ctx.today);
const championships = [
  ...new Map(upcoming.map((r: any) => [r.championship.slug, r.championship])).values(),
];
const names = championships.map((x: any) => displayName(x));
const nearby = all.filter(
  (x: any) => x.page && x.slug !== c.slug && x.country_code === c.country_code,
);

const title = m.cal_circuit_title({ name: c.name, year });
const where = place ? `, ${place}` : '';
const description = upcoming.length
  ? m.cal_circuit_description({
      n: upcoming.length,
      name: c.name,
      place: where,
      names: names.slice(0, 4).join(', '),
      more: names.length > 4 ? m.cal_and_more() : '',
    })
  : m.cal_circuit_description_none({ name: c.name, place: where });

const url = absoluteUrl(`${circuitsBase}${c.slug}/`);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: m.cal_crumb_home(), item: homeUrl },
    {
      '@type': 'ListItem',
      position: 2,
      name: m.cal_crumb_calendar(),
      item: absoluteUrl(calendarBase),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: m.cal_crumb_circuits(),
      item: absoluteUrl(circuitsBase),
    },
    { '@type': 'ListItem', position: 4, name: c.name, item: url },
  ],
};
// The rounds as facts: dates, place, official page (no image in the structured data).
const eventsSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: m.cal_schema_circuit({ name: c.name }),
  itemListElement: upcoming.map((r: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SportsEvent',
      name: `${r.championship.name} – ${r.name}`,
      startDate: r.start_date,
      endDate: r.end_date,
      eventStatus:
        r.status === 'cancelled'
          ? 'https://schema.org/EventCancelled'
          : 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      url: r.url,
      location: {
        '@type': 'Place',
        name: c.name,
        ...(c.country_code && {
          address: { '@type': 'PostalAddress', addressCountry: c.country_code },
        }),
      },
      ...(r.championship.organizer_name && {
        organizer: {
          '@type': 'Organization',
          name: r.championship.organizer_name,
          ...(r.championship.organizer_website_url && {
            url: r.championship.organizer_website_url,
          }),
        },
      }),
    },
  })),
};
---

<BaseLayout title={title} description={description} noindex={data.sample}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {upcoming.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(eventsSchema)} />
  )}
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <section class="band-dark cal-open">
        <div class="page">
          {data.sample && <SampleDataNotice />}

          <nav class="cal-crumbs" aria-label={m.cal_crumb_label()}>
            <a href={calendarBase}>{m.cal_crumb_calendar_nav()}</a>
            <span class="mx-1">/</span>
            <a href={circuitsBase}>{m.cal_crumb_circuits()}</a>
            <span class="mx-1">/</span>
            <span aria-current="page">{c.name}</span>
          </nav>

          <h1 class="display">{m.cal_circuit_h1({ name: c.name, year })}</h1>
          {place && <p class="lede mt-6">{m.cal_circuit_lede({ place })}</p>}
          <CalendarInlineCTA name={c.name} kind="circuit" />
        </div>
      </section>
      <div class="kerb" aria-hidden="true"></div>

      <section class="cal-body">
        <div class="page">
          <div set:html={body} />

          {nearby.length > 0 && (
            <section class="mt-12">
              <h2 class="subtitle mb-4">{m.cal_other_circuits({ place })}</h2>
              <ul class="flex flex-wrap gap-2">
                {nearby.map((x: any) => (
                  <li>
                    <a href={`${circuitsBase}${x.slug}/`} class="cal-chip">
                      {x.name}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <p class="mt-10 text-sm">
            <a href={calendarBase} class="link">
              {m.cal_all_championships()}
            </a>
            <span class="mx-1">·</span>
            <a href={circuitsBase} class="link">
              {m.cal_all_circuits()}
            </a>
          </p>
        </div>
      </section>
      <CalendarCTA title={m.cal_cta_circuit_title({ name: c.name })} />
    </main>
    <Footer />
  </div>
</BaseLayout>
