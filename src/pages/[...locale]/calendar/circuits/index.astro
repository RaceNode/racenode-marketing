---
import { absoluteUrl, hasPrefix, link, localePathsOf, localeTag, type Locale } from '@/i18n';
import { m } from '@/paraglide/messages';
import { getLocale } from '@/paraglide/runtime';

export const getStaticPaths = () => localePathsOf('calendar/circuits');
// Every circuit that has its own calendar page, by country: the way in to /calendar/circuits/<slug>/ for visitors
// and search engines. Built each morning with the rest; nothing here is refreshed in the browser.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CalendarCTA from '@/components/calendar/CalendarCTA.astro';
import SampleDataNotice from '@/components/calendar/SampleDataNotice.astro';
import { catalog, localized } from '@/lib/calendar/build.mjs';
import { circuits } from '@/lib/calendar/model.mjs';

const locale = getLocale() as Locale;
const loaded = await catalog();
const { data, cal } = loaded;
const calendarBase = link(locale, 'calendar');
const circuitsBase = link(locale, 'calendar/circuits');
const ctx = localized(loaded, locale, calendarBase);
const homeUrl = hasPrefix(locale)
  ? absoluteUrl(link(locale))
  : absoluteUrl(link(locale)).replace(/\/$/, '');
const pages = circuits(cal).filter((c: any) => c.page);
const byCountry = new Map<string, any[]>();
for (const c of pages) {
  const name = c.country_code
    ? (ctx.countries[c.country_code] ?? c.country_code)
    : m.cal_other_country();
  if (!byCountry.has(name)) byCountry.set(name, []);
  byCountry.get(name)!.push(c);
}
const countries = [...byCountry].sort(([a], [b]) => a.localeCompare(b, localeTag(locale)));
const upcoming = (c: any) => c.rounds.filter((r: any) => r.end_date >= ctx.today).length;

const title = m.cal_circuits_index_title({ year: cal.year });
const description = m.cal_circuits_index_description({ n: pages.length, year: cal.year });
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: m.cal_crumb_home(), item: homeUrl },
    {
      '@type': 'ListItem',
      position: 2,
      name: m.cal_crumb_calendar(),
      item: absoluteUrl(calendarBase),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: m.cal_crumb_circuits(),
      item: absoluteUrl(circuitsBase),
    },
  ],
};
---

<BaseLayout title={title} description={description} noindex={data.sample}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <section class="band-dark cal-open">
        <div class="page">
          {data.sample && <SampleDataNotice />}

          <nav class="cal-crumbs" aria-label={m.cal_crumb_label()}>
            <a href={calendarBase}>{m.cal_crumb_calendar_nav()}</a>
            <span class="mx-1">/</span>
            <span aria-current="page">{m.cal_crumb_circuits()}</span>
          </nav>

          <h1 class="display">{m.cal_circuits_index_h1()}</h1>
          <p class="lede mt-6 max-w-3xl">{m.cal_circuits_index_lede()}</p>
        </div>
      </section>
      <div class="kerb" aria-hidden="true"></div>

      <section class="cal-body">
        <div class="page">
          {countries.map(([country, list]) => (
            <section class="mb-8">
              <h2 class="cal-month-title">{country}</h2>
              <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2">
                {list.map((c: any) => (
                  <li>
                    <a href={`${circuitsBase}${c.slug}/`} class="cal-card">
                      <span>{c.name}</span>
                      <span>
                        {upcoming(c)
                          ? upcoming(c) === 1
                            ? m.cal_n_upcoming_one({ n: 1 })
                            : m.cal_n_upcoming_other({ n: upcoming(c) })
                          : m.cal_circuit_upcoming_none()}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}

          <p class="mt-10 text-sm">
            <a href={calendarBase} class="link">
              {m.cal_all_championships()}
            </a>
          </p>
        </div>
      </section>
      <CalendarCTA />
    </main>
    <Footer />
  </div>
</BaseLayout>
