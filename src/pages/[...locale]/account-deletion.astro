---
import { localePathsOf } from '@/i18n';

export const getStaticPaths = () => localePathsOf('account-deletion');
import LegalLayout from '@/layouts/LegalLayout.astro';
import { legalText } from '@/data/legal';
import { getLocale } from '@/paraglide/runtime';
import { m } from '@/paraglide/messages';

const Content = legalText('account-deletion.md', getLocale());
---

<LegalLayout
  title={m.deletion_title()}
  description={m.deletion_description()}
  heading={m.deletion_heading()}
>
  <Content />
</LegalLayout>
