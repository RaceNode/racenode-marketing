---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { breadcrumbJsonLd, faqJsonLd } from '../lib/seo';
import { site } from '../site.config';
import { modules } from '../data/modules';

// Prices and wording: Willi, 2026-10-26. Free for everyone until 31 December 2026; from 2027 a free trial that
// lasts until the end of the team's first event (any kind of event), then a subscription. Simple, factual, no slogan.
const appUrl = 'https://app.racenode.com';
const title = 'Pricing — €99 per month, your first event free | RaceNode';
const description =
  'RaceNode is free for everyone until 31 December 2026. Then try it free on your first event, and subscribe for €99 per month or €990 per year, excl. VAT, per team. Every module included.';

const faq = [
  {
    q: 'How much does RaceNode cost?',
    a: '€99 per month or €990 per year, excl. VAT, per team. Every module included.',
  },
  {
    q: 'How does the free trial work?',
    a: 'Your trial lasts until your first event on RaceNode is over, whatever that event is. No card needed.',
  },
  {
    q: 'What happens after my first event?',
    a: 'Subscribe to keep using RaceNode. Your data is not deleted.',
  },
  {
    q: 'Is RaceNode free in 2026?',
    a: 'Yes. RaceNode is free for everyone until 31 December 2026.',
  },
];

const breadcrumbSchema = breadcrumbJsonLd(site, [
  { name: 'Home', url: '/' },
  { name: 'Pricing', url: '/pricing/' },
]);

const faqSchema = faqJsonLd(
  site,
  '/pricing/',
  faq.map((item) => ({ question: item.q, answer: item.a })),
);
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="min-h-screen bg-concrete">
    <Header />
    <main>
      <!-- Opening, as on the module pages: the page's name, the trial, then the price on the band itself. -->
      <section class="band band-dark">
        <div class="page grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-10">
          <div class="lg:col-span-7">
            <p class="font-display text-lg font-medium text-smoke">Pricing</p>
            <h1 class="display mt-5">Try RaceNode free on your first event.</h1>
          </div>
          <div class="lg:col-span-5 lg:pt-12">
            <p class="flex items-baseline gap-3">
              <span class="display">€99</span>
              <span class="lede">per month</span>
            </p>
            <p class="lede mt-2">or €990 per year</p>
            <p class="mt-3 text-smoke">Excl. VAT, per team. Every module included.</p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-5">
              <a href={`${appUrl}/signup`} class="btn-primary text-lg">
                Start free
              </a>
              <span class="text-sm text-smoke">No card needed for the trial</span>
            </div>
            <p class="hair mt-8 pt-5 text-fog">Free for everyone until 31 December 2026.</p>
          </div>
        </div>
      </section>
      <div class="kerb" aria-hidden="true"></div>

      <!-- What the price covers: the four modules, from the same data as the header menu. -->
      <section class="band">
        <div class="page">
          <div class="head">
            <h2 class="title">Every module included.</h2>
          </div>
          <ul class="grid gap-x-12 gap-y-10 md:grid-cols-2">
            {modules.map((module) => (
              <li>
                <a href={module.href} class="group block">
                  <h3 class="ruled font-display text-2xl font-bold">{module.name}</h3>
                  <p class="muted mt-3 max-w-xl leading-relaxed">{module.short}</p>
                  <span class="link mt-3 inline-block decoration-transparent group-hover:decoration-current">
                    See {module.name} <span aria-hidden="true">→</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- FAQ -->
      <section class="band band-paper">
        <div class="page grid gap-10 lg:grid-cols-12 lg:gap-10">
          <h2 class="title lg:col-span-4">Frequently asked questions</h2>
          <div class="lg:col-span-8">
            {faq.map((item) => (
              <div class="hair py-6">
                <h3 class="font-display text-xl font-semibold">{item.q}</h3>
                <p class="muted mt-2 max-w-2xl text-lg leading-relaxed">{item.a}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
