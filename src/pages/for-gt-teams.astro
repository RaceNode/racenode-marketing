---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const appUrl = "https://app.racenode.com";

const title = "GT Racing Team Management Software — GT3, GT4, Sprint Cup | RaceNode";
const description = "GT racing team management software for GT3 and GT4 crews. Coordinate drivers, engineers, mechanics, accommodation, and travel across the GT championship calendar.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.racenode.com" },
    { "@type": "ListItem", "position": 2, "name": "GT Teams", "item": "https://www.racenode.com/for-gt-teams" }
  ]
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="min-h-screen bg-gray-950">
    <Header />
    <main>
      <section class="px-4 sm:px-6 lg:px-8 py-20 md:py-28">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-gray-800 text-gray-300 rounded-full text-sm mb-6 border border-gray-700">
            For GT racing teams
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            GT racing team management, built for the championship calendar.
          </h1>
          <p class="text-xl md:text-2xl text-gray-400 mb-10">
            RaceNode helps GT3 and GT4 teams run a full season — Sprint Cup, Endurance Cup, national series — with structured crew compositions, fleet tracking, and travel logistics for every round.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href={`${appUrl}/signup`} class="bg-green-600 hover:bg-green-700 text-white px-8 py-3 rounded-lg text-lg font-semibold transition-colors">Get started</a>
            <span class="text-gray-500 text-sm">Free for the 2026 season</span>
          </div>
        </div>
      </section>

      <section class="px-4 sm:px-6 lg:px-8 py-16 md:py-20 bg-gray-900/50">
        <div class="max-w-5xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-10 text-center">Why GT teams choose RaceNode</h2>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
              <h3 class="text-xl font-semibold text-white mb-3">Customer cars and full-factory programs</h3>
              <p class="text-gray-400">Whether you run two customer GT3s or four cars across two championships, RaceNode structures each entry: drivers, engineer, mechanics, tyre techs, all assigned per event.</p>
            </div>
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
              <h3 class="text-xl font-semibold text-white mb-3">Sprint and endurance formats in one tool</h3>
              <p class="text-gray-400">A GT season mixes 1-hour sprints with 3-hour, 6-hour, and 24-hour races. Each event has its own crew composition and logistics needs — RaceNode handles both formats without forcing you to switch tools.</p>
            </div>
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
              <h3 class="text-xl font-semibold text-white mb-3">Driver pairings managed per round</h3>
              <p class="text-gray-400">GT teams swap pro and amateur drivers, run silver and bronze pairings, juggle FIA categories. RaceNode tracks who drives what, where, with whom — across the full championship.</p>
            </div>
            <div class="bg-gray-900 border border-gray-800 rounded-xl p-6">
              <h3 class="text-xl font-semibold text-white mb-3">Travel across European circuits</h3>
              <p class="text-gray-400">Spa, Monza, Paul Ricard, the Nürburgring, Imola — a GT season is a logistics challenge. RaceNode manages flights, hotels, transporters, and rentals for every round in one rooming list per circuit.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="px-4 sm:px-6 lg:px-8 py-16 md:py-20">
        <div class="max-w-5xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Two modules, one GT racing workspace</h2>
          <p class="text-lg text-gray-400 mb-10 max-w-2xl mx-auto">RaceNode is modular. Use what your GT team needs.</p>
          <div class="grid md:grid-cols-2 gap-6 text-left">
            <a href="/management" class="block bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-orange-500/50 transition-colors">
              <h3 class="text-xl font-bold text-white mb-3">Race Team Management</h3>
              <p class="text-gray-400">Crew compositions per car, driver pairings per round, meal planning per event.</p>
            </a>
            <a href="/logistics" class="block bg-gray-900 border border-gray-800 rounded-xl p-6 hover:border-purple-500/50 transition-colors">
              <h3 class="text-xl font-bold text-white mb-3">Motorsport Logistics</h3>
              <p class="text-gray-400">Hotels, flights, transporters, and rentals for every round of the GT calendar.</p>
            </a>
          </div>
        </div>
      </section>

      <section class="px-4 sm:px-6 lg:px-8 py-16 md:py-20 bg-gray-900/50">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Run your GT team from one platform</h2>
          <p class="text-lg text-gray-400 mb-8">Free for the entire 2026 GT season.</p>
          <a href={`${appUrl}/signup`} class="inline-block bg-green-600 hover:bg-green-700 text-white px-8 py-3 rounded-lg text-lg font-semibold transition-colors">Start using RaceNode</a>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
