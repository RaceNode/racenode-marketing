{
  "name": "racenode-marketing",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/store/check.mjs && node scripts/guardrails.mjs && astro build && node scripts/guardrails.mjs --dist",
    "guardrails": "node scripts/guardrails.mjs",
    "test:guardrails": "node --test scripts/guardrails.test.mjs",
    "test:calendar": "node --test src/lib/calendar/calendar.test.mjs src/lib/calendar/logos.test.mjs",
    "test:seo": "node --test src/lib/seo.test.mjs",
    "test": "npm run check && npm run lint && npm run test:guardrails && npm run test:calendar && npm run test:seo",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^7.2.4",
    "posthog-js": "^1.438.3",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "opentype.js": "^2.0.0",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
